async function
  _overrides_set() {
  let
    _msg;
  _override_set(
    "call",
    "date",
    _get_date_human());
  _override_set(
    "lock",
    "only",
    "n");
  _override_set(
    "config",
    "dir",
    _path_join([
      _homedir_get(),
      ".config",
      "evmfs"]));
  _override_set(
    "cache",
    "dir",
    _path_join([
      _homedir_get(),
      ".cache",
      "evmfs"]));
  _override_set(
    "rpc",
    "selection",
    "kirsh");
  _override_set(
    "chunk",
    "length",
    "22000");
  _override_set(
    "call",
    "method",
    "boh");
  _override_set(
    "encoding",
    "skip",
    "n");
  _tasks_parallel_auto_detect();
  _override_set(
    "user",
    "level",
    "n");
  _override_set(
    "wallet",
    "name",
    "default");
  _call_timeout_auto_detect();
  _override_set(
    "encoding",
    "type",
    "sha256sum");
  _override_set(
    "retries",
    "max",
    3);
  _call_auth_auto_detect();
  _input_files_auto_detect();
  try {
    _input_uris_auto_detect();
  }
  catch(
    _error) {
    _msg =
      "Error detecting input file.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  try { 
    _output_files_auto_detect();
  }
  catch(
    _error) {
    _msg =
      "Error detecting output file.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  const
    _app_name =
      _get(
        "app",
        "name");
  try {
    await _libevm_app_overrides_set(
      "evmfs");
  }
  catch(
    _error) {
    _msg =
      "Error auto-detecting " +
      "LibEVM application variables.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  try {
    await _contracts_auto_detect();
  }
  catch(
    _error) {
    _msg =
      "Error running '_contracts_auto_detect'.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  const
    _call_auth =
      _get(
        "call",
        "auth");
  const
    _target_networks =
      _get(
        "target",
        "networks");
  _override_set(
    "index",
    "network",
    _target_networks[
      0]);
  if ( _call_auth == "y" ) {
    const
      _wallet_name =
        _get(
          "wallet",
          "name");
    const
      _wallet_overrides_set_args = [
        "evm-wallet",
        _wallet_name,
        _call_auth,
        "n",               // QR support
        _target_networks
      ];
    const
      _wallet_overrides_set_up =
        await _wallet_overrides_set.apply(
          null,
          _wallet_overrides_set_args);
  }
  else if ( _call_auth == "n" ) {
    true;
  }
  else {
    _msg =
      `Unknown value '${_call_auth}' ` +
      "for 'call_auth' variable.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
}

