function
  _config_show() {
  let
    _text;
  /* LibEVM-defined global variables */
  /* global
       api_key */
  /* global
       wallet_address */
  /* global
       wallet_password */
  /* global
       wallet_path */
  /* global
       wallet_seed */
  let
    _item,
    _line;
  const
    _program =
      _basename(
        _argv[
          0]);
  _text = [
    `${_program} configuration:`,
    `                       Call date:   ${call_date}`,
    `             Runtime environment:   ${runtime_environment}`,
    `                  Target command:   ${target_command}`,
    `                      Target key:   ${target_key}`,
    `                    Target value:   ${target_value}`,
    `                   Index network:   ${index_network}`,
    `                     Call method:   ${call_method}`,
    `                    Chunk length:   ${chunk_length}`,
    `           Publication options:`,
    `                       Lock only:   ${lock_only}`,
    `                   Skip encoding:   ${encoding_skip}`,
    `                   Encoding type:   ${encoding_type}`,
    `                     Input files:`,
  ];
  for ( _item of input_files ) {
    _text.push(
      `                                    ${_item}`);
  }
  _text.push(
    "              Download options:");
  _text.push(
    `                      Input URIs:`);
  for ( _item of input_uris ) {
    _text.push(
      `                                    ${_item}`);
  }
  _text.push(
    `                    Output files:`);
  for ( _item of output_files ) {
    _text.push(
      `                                    ${_item}`);
  }
  _text =
    _text.concat([
      "              Contract options:",
      `             File system address:   ${fs_address}`,
      ` Cross-chain file system address:   ${ccfs_address}`,
      `             File system version:   ${fs_version}`,
      `           Credentials options:`,
      `                     Wallet name:   ${wallet_name}`,
      `                  Wallet address:   ${wallet_address}`,
      `                     Wallet path:   ${wallet_path}`,
      `                     Wallet seed:   ${wallet_seed}`,
      `                         API Key:   ${api_key}`,
      "                LibEVM options:",
      `                      User level:   ${user_level}`,
      `           Deployments directory:   ${deployments_dir}`,
      `                 Target networks:   ${target_networks}`,
      `               Network options:`,
      `                 Maximum retries:   ${retries_max}`,
      `                    Call timeout:   ${call_timeout}`,
      `                  Parallel tasks:   ${tasks_parallel}`,
      `           Application options:`,
      `                 Cache directory:   ${cache_dir}`,
    ]);
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
}

async function
  _main() {
  let
    _msg,
    _result,
    _results;
  try {
    const
      _overrides_set_up =
        await _overrides_set();
  }
  catch(
    _error) {
    _msg =
      "Error setting overrides.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  _config_show();
  const
    app_opts = [
      target_command,
      fs_address,
      ccfs_address,
      ll_address,
      fs_version,
      deployments_dir,
      wallet_name,
      wallet_path,
      wallet_password,
      wallet_seed,
      target_networks,
      api_key,
      call_method,
      index_network,
      retries_max,
      call_timeout,
      lock_only,
      chunk_length,
      encoding_skip,
      encoding_type,
      tasks_parallel,
      price_gas,
      cache_dir,
      user_level,
      input_files,
      output_files,
      input_uris,
      target_key,
      target_value
    ];
  try {
    _results =
      await _evmfs.apply(
        null,
        app_opts);
  }
  catch(
    _error) {
    _msg =
      "Error running '_evmfs' " +
      "with arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      app_opts);
    _echo2(
      _error);
    throw _error;
  }
  const
    _results_type =
      typeof(
        _results);
  if ( _results_type == "bigint" ) {
    _echo(
      _results.toString());
  }
  else if ( _results_type == "string" ) {
    _echo(
      _results);
  }
  else if ( _results_type == "object" ) {
    for ( _result of _results ) {
      _echo(
        _result);
    }
  }
  else if ( _results_type == "undefined" ) {
    _msg =
      `No results.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  else {
    _msg =
      "Error retrieving results for command. " +
      `Type of return: '${_results_type}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
}

