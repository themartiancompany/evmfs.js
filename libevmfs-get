function
  _input_uris_auto_detect() {
  let
    _input_uris,
    _msg,
    _uri;
  _input_uris =
    _get(
      "input",
      "uris");
  const
    _target_command =
      _get(
        "target",
        "command");
  const
    _target_key =
      _get(
        "target",
        "key");
  const
    _target_value =
      _get(
        "target",
        "value");
  const
    _command_args =
      _get(
        "command",
        "args");
  if ( _target_command === "get" ) {
    if ( _target_key === "" ) {
      _msg =
        "No input URI.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    _input_uris.push(
      _target_key);
    if ( _target_value != "" ) {
      _input_uris.push(
        _target_value);
    }
    if ( 0 < _command_args.length ) {
      _input_uris =
        _input_uris.concat(
          _command_args);
    }
    _set(
      "input",
      "uris",
      _input_uris);
  }
}

async function
  _output_files_auto_detect() {
  let
    _msg,
    _output_file,
    _uri;
  const
    _output_files =
      _get(
        "output",
        "files");
  const
    _input_uris =
      _get(
        "input",
        "uris");
  const
    _target_command =
      _get(
        "target",
        "command");
  if ( _target_command === "get" ) {
    if ( _output_files.length < 1 ) {
      for ( _uri of _input_uris ) {
        try {
          _output_file =
            _hash_get(
              _uri);
        }
        catch(
          _error) {
          _msg =
            `URI '${_uri}' ` +
            `is malformed.`;
          _msg_error(
            _msg,
            0);
          _echo2(
            _error);
          throw _error;
        }
        _output_files.push(
          _output_file);
      }
      _set(
        "output",
        "files",
        _output_files);
    }
    else {
      const
        _input_uris =
          _get(
            "input",
            "uris");
      if ( _input_uris.length < _output_files.length ) {
        _msg =
          "More output files than input URIs.";
        _msg_error(
          _msg,
          0);
        throw _msg;
      }
      else if ( _output_files.length < _input_uris.length ) {
        _msg =
          "More output files than input URIs.";
        _msg_error(
          _msg,
          0);
        throw _msg;
      }
    }
  }
}

