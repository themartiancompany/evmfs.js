async function
  _chunks_get_sync(
    _fs_address,
    _fs_version,
    _user_level,
    _api_key_path,
    _deployments_dir,
    _uri_network_id,
    _uri_namespace,
    _uri_hash,
    _chunks_dir,
    _length,
    _tasks_parallel,
    _retries_max) {
  let
    _chunk,
    _chunk_get_args,
    _fs_abi,
    _fs_bytecode,
    _fs_compiler_output,
    _index,
    _method_object,
    _msg,
    _piece;
  const
    _chunks =
      [];
  _method_object =
    {};
  const
    _libevm_app_contract_setup_args = [
      "evmfs",                  // application name
      "FileSystem",             // contract name
      "_fs",                    // contract short name
      _fs_version,
      _uri_network_id,
      _user_level,
      _deployments_dir,
      "evmfs-contracts",
      "json",                   // configuration format
      ""                        // configuration file path
    ];
  const
    _global =
      _global_get();
  const
    _quiet =
      _global[
        "quiet"];
  _msg =
    "Running '_libevm_app_contract_setup' " +
    "with arguments:";
  _msg_info(
    _msg);
  if ( _quiet == "n" ) {
    _echo(
      _libevm_app_contract_setup_args);
  }
  try {
    [ _fs_abi,
      _fs_bytecode,
      _fs_compiler_output ] =
    await _libevm_app_contract_setup.apply(
      null,
      _libevm_app_contract_setup_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_libevm_contract_setup' " +
      "with arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  for ( _chunk of _seq(
                    _length) ) {
    _msg =
      "Downloading chunk " +
      `'${_chunk}' of '${_length}'.`;
    _msg_info(
      _msg);
    _index =
      _chunk - 1;
    _piece =
      _path_join([
        _chunks_dir,
        `${_uri_hash}.${_chunk}`
      ]);
    _chunk_get_args = [
      _fs_address,
      _fs_abi,
      _fs_bytecode,
      _fs_compiler_output,
      _uri_network_id,
      _uri_namespace,
      _uri_hash,
      _index,
      _piece,
      _api_key_path,
      _retries_max,
      _method_object,
      _piece
    ];
    _msg =
      "Running '_chunk_get' with arguments:";
    _msg_info(
      _msg);
    if ( _quiet == "n" ) {
      _echo(
        _chunk_get_args);
    }
    try {
      _method_object =
        await _chunk_get.apply(
          null,
          _chunk_get_args);
    }
    catch(
      _error) {
      _msg =
        `Error retrieving chunk ` +
        `with index '${_index}'`;
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    _chunks.push(
      _piece);
  }
  return _chunks;
}

