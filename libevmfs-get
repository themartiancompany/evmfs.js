    _ll_bytecode_path,
    _ll_compiler_output_path,
    {},                       // method object
    _ll_address,
    "lock",
    _method_args,
    {}                        // _contract_object
  ];
  try {
    [ _locked ] =
      await _contract_call_static.apply(
        null,
        _contract_call_static_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_contract_call_static' " +
      "with arguments:";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  if ( _locked === true ) {
    _contract_call_static_args = [
      "",                       // wallet seed,
      _retries_max,
      _api_key_path,
      _target_network,
      _ll_abi_path,
      _ll_bytecode_path,
      _ll_compiler_output_path,
      {},                       // method object
      _ll_address,
      "getLength",
      _method_args,
      {}                        // _contract_object
    ];
    try {
      [ _length ] =
        await _contract_call_static.apply(
          null,
          _contract_call_static_args);
    }
    catch(
      _error) {
      _msg =
        "Error running '_contract_call_static' " +
        "with arguments:";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
  }
  else if ( _locked === false ) {
    _msg =
      "File with hash " +
      `'${_uri_hash}' is unlocked.`;
    _msg_info(
      _msg);
  }
  else {
    _msg =
      "The lock boolean should be a boolean, " +
      `not '${_locked}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  const
    _resource_length_type =
      typeof(
        _resource_length);
  if ( _resource_length_type === "undefined" ) {
    _msg =
      "The file length is not locked, " +
      "the uploader could break " +
      "the file at a later time, lock " +
      "the length in your namespace to " +
      "avoid making harder for yourself " +
      "accessing the file.";
    _msg_warning(
      _msg);
    _length =
      0;
  }
  const
    _output = [
      _length,
      _locked
    ];
  return _output;
