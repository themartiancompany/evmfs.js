  if ( ! _dir_exists(
          _output_dir) ) {
    const
      _mkdir_opts = {
        "recursive":
          true
      };
    _mkdir(
      _output_dir,
      _mkdir_opts);
  }
  const
    _out =
      _path_join([
        _output_dir,
        `${_sum}.base64`
      ]);
  _msg =
    "Chunking files.";
  const
    _encoding_type =
      "memory";
  _msg_info(
    _msg);
  const
    _bin2txt_args = [
      _file,
      _out,
      _encoding_format,
      _chunk_length,
      _buffer_size_bytes,
      _amount_only,
      _encoding_type
    ];
  try {
    [ _chunks_total,
      _chunks ] =
      await _bin2txt.apply(
        null,
        _bin2txt_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_bin2txt' " +
      "arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      _bin2txt_args);
    _echo2(
      _error);
    throw _error;
  }
  _msg =
    `Found '${_chunks_total}' ` +
    "encoded chunks.";
  _msg_info(
    _msg);
  return _chunks;
}

async function
  _resource_get(
    _ll_address,
    _uri_network_id,
    _uri_contract,
    _uri_namespace,
    _uri_hash,
    _fs_version,
    _user_level,
    _deployments_dir,
    _call_method,
    _tasks_parallel,
    _retries_max,
    _cache_dir,
    _api_key_path,
    _output_file) {
  let
    _attempt,
    _chunks,
    _chunks_total,
    _msg;
  const
    _tmp_dir =
      _path_join([
        _cache_dir,
        _uri_hash,
        "get"
      ]);
  const
    _check_file_path =
      _path_join([
        _cache_dir,
        _uri_hash,
        "check"
      ]);
  try {
    const
      _mkdir_opts = {
        "recursive":
          true
      };
    _mkdir(
      _tmp_dir,
      _mkdir_opts);
  }
  catch(
    _error) {
    const
      _code =
        _error[
          'code'];
    if ( _code === "EEXIST" ) {
      true;
    }
    else {
      _msg =
        "Error creating cache directory " +
        `'${_tmp_dir}'.`;
      _msg_error(
        _msg,
        0);
      throw _error;
    }
  }
  if ( _fs_version === "1.0" ) {
    const
      _chunks_total_get_args = [
        _ll_address,
        _uri_network_id,
        _uri_contract,
        _uri_namespace,
        _uri_hash,
        _fs_version,
        _user_level,
        _deployments_dir,
        _retries_max,
        _api_key_path
      ];
    try {
      _chunks_total =
        await _chunks_total_get.apply(
          null,
          _chunks_total_get_args);
    }
    catch(
      _error) {
      _msg =
        "Error running '_chunks_total_get' " +
        "with arguments:";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
  }
  _attempt =
    1;
  while ( _attempt < _retries_max ) {
    try {
      if ( 1 < _tasks_parallel ) {
        const
          _chunks_get_async_args = [
            _tmp_dir,
            _chunks_total,
            _tasks_parallel
          ];
        await _chunks_get_async.apply(
          null,
          _chunks_get_async_args);
      }
      else if ( 1 == _tasks_parallel ) {
        if ( _call_method === "standalone" ) {
          const
            _chunks_get_sync_args = [
              _uri_contract,
              _fs_version,
              _user_level,
              _api_key_path,
              _deployments_dir,
              _uri_network_id,
              _uri_namespace,
              _uri_hash,
              _tmp_dir,
              _chunks_total,
              _tasks_parallel,
              _retries_max
            ];
          _msg =
            "Running '_chunks_get_sync' " +
            "with arguments:";
          _msg_info(
            _msg);
          const
            _global =
              _global_get();
          const
            _quiet =
              _global[
                "quiet"];
          if ( _quiet == "n" ) {
            _echo(
              _chunks_get_sync_args);
          }
          _chunks =
            await _chunks_get_sync.apply(
              null,
              _chunks_get_sync_args);
        }
        else if ( _call_method === "bulk" ||
                  _call_method === "library" ) {
          _msg =
            "I'll connect tomorrow the 'library'/'bulk' " +
            "get method.";
          _msg_error(
            _msg,
            0);
          throw _msg;
        }
        else {
          _msg =
            "Unknown call method " +
            `'${_call_method}'.`;
          _msg_error(
            _msg,
            0);
          throw _msg;
        }
      }
    }
    catch(
      _error) {
      _msg =
        "Invalid value for parallel tasks " +
        `('${_tasks_parallel}').`;
      _msg_error(
        _msg,
        0);
      _attempt =
        _attempt + 1;
    }
    break;
  }
  if ( _attempt == _retries_max ) {
    _msg =
      "Maximum amount of retries " +
      "reached.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  _msg =
    `Got '${_chunks_total}' chunks. ` +
    `Merging.`;
  _msg_info(
    _msg);
  const
    _txt2bin_args = [
      _check_file_path,
      "base64",          // encoding format
      "file",            // argument type
      "",                // unused argument
      _chunks,           // input files
      true               // input files sanity check
    ];
  try {
    await _txt2bin.apply(
      null,
      _txt2bin_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_txt2bin' with arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      _txt2bin_args);
    throw _error;
  }
  const
    _resource_validate_args = [
      _check_file_path,
      _uri_hash
    ];
  try {
    await _resource_validate(
      null,
      _resource_validate_args);
  }
  catch(
    _error) {
    _msg =
      "Error running '_resource_validate' with arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      _resource_validate_args);
    throw _error;
  }
  try {
    _mv(
      _check_file_path,
      _output_file);
  }
  catch(
    _error) {
    const
      _code =
        _error[
          "code"];
    if ( _code === "EXDEV" ) {
      try {
        _cp(
          _check_file_path,
          _output_file); 
        _rm(
          _check_file_path);
      }
      catch(
        _error) {
        _msg =
          "Error moving " +
          `'${_check_file_path} ` +
          `to '${_output_file}.`;
        _msg_error(
          _msg,
          0);
        _echo2(
          _error);
        throw _error;
      }
    }
    else {
      _msg =
        "Error moving " +
        `'${_check_file_path} ` +
        `to '${_output_file}.`;
      _msg_error(
        _msg,
        0);
      _echo2(
        _resource_validate_args);
      _echo2(
        _error);
      throw _error;
    }
  }
  _msg =
    "Output correctly moved onto " +
    `'${_output_file}'.`;
  _msg_info(
    _msg);
}

