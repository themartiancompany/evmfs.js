    _msg =
      "Unknown type " +
       `'${_encoding_type_type}' for ` +
      "variable 'encoding type'. " +
      "Admissable values are of type string " +
      "with value 'base64'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _encoding_type_get ) {
    const
      _publish_dir
    _encoding_type =
      _default;
  }
  return _encoding_type;
}

function
  _msg_info_chunk_get(
    _index,
    _progress,
    _total) {
  const
    _msg =
      `Downloading chunk '${_index}' ` +
      `('${_progress}'of '${_total}').`;
  _msg_info(
    _msg);
}

function
  _msg_info_chunk_got(
    _index,
    _progress,
    _total) {
  const
    _msg =
      `Downloaded chunk '{_index}' ` +
      `('${_progress}'of '${_total}').`;
  _msg_info(
    _msg);
}

function
  _input_data_check(
    _index_start,
    _index_end,
    _total_files) {
  let
    _flag,
    _msg;
  const
    _total_indexes =
      _index_end - _index_start + 1;
  _flag =
    false;
  if ( _total_files == 0 ) {
    _msg =
      "File chunks list empty.";
    _flag =
      true;
  }
  if ( _total_files > _total_indexes ) {
    _msg =
      "More files to save into than " +
      "indexes to download.";
    _flag =
      true;
  }
  if ( _total_files < _total_indexes ) {
    _msg =
      "More indexes downloads " +
      "than files to save into.";
    _flag =
      true;
  }
  if ( _flag ) {
    _msg_error(
      _msg,
      1);
  }
  _msg =
    "Input data checked.";
  _msg_info(
    _msg);
}

