function
  _cache_dir_check(
    _cache_dir) {
  let
    _cache_dir_get;
  const
    _cache_dir_type =
      typeof(
        _cache_dir);
  if ( _cache_dir_type === "undefined" ) {
    _msg =
      "Cache directory undefined, " +
      "setting default.";
    _msg_info(
      _msg);
    _cache_dir_get =
      true;
  }
  else if ( _cache_dir_type === "string" ) {
    if ( _cache_dir.length < 1 ) {
      _msg =
        "Cache directory is an empty string, " +
        "setting default.";
      _msg_info(
        _msg);
      _cache_dir_get =
        true;
    }
  }
  else {
    _msg =
      `Unknown type '${_cache_dir_type}' ` +
      "for variable 'cache_directory'. " +
      "Allowed type is string with value " +
      "an existing directory, except if value " +
      "corresponds to the XDG directory.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _cache_dir_get ) {
    const
      _home =
        _homedir_get();
    try {
      [ _cache_dir ] =
        _cache_user_init(
          "evmfs")
    }
    catch(
      _error) {
      _msg =
        "Error running '_cache_user_init' " +
        "with argument 'evmfs'.";
      _msg_error(
        _msg,
        0);
      _echo2(
        _error);
      throw _error;
    }
  }
  return _cache_dir;
}

function
  _chunk_file_path_check(
    _path,
    _index,
    _cursor) {
  let
    _msg;
  const
    _path_type =
      typeof(
        _path);
  if ( _path_type === "undefined" ) {
    _msg =
      "Chunk file for index " +
      `'${_index}' and cursor ` +
      `'${_cursor}' undefined.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  else if ( _path_type === "string" ) {
    if ( _path.length < 1 ) {
      _msg =
        "Chunk file for index " +
        `'${_index}' and cursor ` +
        `'${_cursor}' not specified.`;
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
  }
  else {
    _msg =
      `Unknown type '${_path_type}' for ` +
      `variable '_path' in function ` +
      `'_chunk_file_path_check' run with ` +
      `arguments ('${_path}','${_index}','${_cursor}').`;
    msg_error(
      _msg,
      0);
    throw _msg;
  }
  return _path;
}

async function
  _encoding_type_check(
    _encoding_type,
    _cache_dir,
    _sum) {
  let
    _encoding_type_get,
    _msg;
  const
    _default =
      "base64";
  const
    _encoding_type_type =
      typeof(
        _encoding_type);
  _encoding_type_get =
    false;
  if ( _encoding_type_type === "undefined" ) {
    _msg =
      "Encoding type undefined, " +
      `setting default '${_default}'.`;
    _encoding_type_get =
      true;
  }
  else if ( _encoding_type_type === "string" ) {
    if ( _encoding_type.length < 1 ) {
      _msg =
        "Encoding type is an empty string, " +
        `setting default '${_default}'.`;
      _encoding_type_get =
        true;
    }
