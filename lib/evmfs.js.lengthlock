/* Crash Javascript global variables */

/* global
     quiet:
       writable */

const
  _libcrash =
    require(
      "crash-js");
const
  _cmdline_check =
    _libcrash._cmdline_check;
const
  _error_display =
    _libcrash._error_display;
const
  _file_write =
    _libcrash._file_write;
const
  _msg_info =
    _libcrash._msg_info;
const
  _msg_error =
    _libcrash._msg_error;
const
  _override_set =
    _libcrash._override_set;
const
  _process_exit =
    _libcrash._process_exit;
const
  _evm_contracts_tools_module =
    require(
      "evm-contracts-tools");
/* global
     _contract_call_static */
const
  _contract_call_static =
    _evm_contracts_tools_module._contract_call_static;
function
  _global_variables() {
  /* global
       app_name:
         writable */
  app_name =
    "evmfs.js.lengthlock";
  /* global
       app_opts:
         writable */
  app_opts =
    [];
  /* global
       retries_max:
         writable */
  retries_max =
    "";
  /* global
       api_key_path:
         writable */
  api_key_path =
    "";
  /* global
       target_network:
         writable */
  target_network =
    "";
  /* global
       contract_address:
         writable */
  contract_address =
    "";
  /* global
       contract_abi_path:
         writable */
  contract_abi_path =
    "";
  /* global
       contract_bytecode_path:
         writable */
  contract_bytecode_path =
    "";
  /* global
       contract_compiler_output_path:
         writable */
  contract_compiler_output_path =
    "";
  /* global
       method_object:
         writable */
  method_object =
    "";
  /* global
       publication_namespace:
         writable */
  publication_namespace =
    "";
  /* global
       disk_write:
         writable */
  disk_write =
    "";
  /* global
       checkpoint_file_path:
         writable */
  checkpoint_file_path =
    "";
  /* global
       files_hashes:
         writable */
  files_hashes =
    [];
  /* global
       files_locks_paths:
         writable */
  files_locks_paths =
    [];
  /* global
       files_lengths_paths:
         writable */
  files_lengths_paths =
    [];
  quiet =
    "";
}

function
  _msg_info_length_get(
    _hash,
    _progress,
    _total) {
  const
    _msg =
      `Getting length for hash '${_hash}' ` +
      `('${_progress}'of '${_total}').`;
  _msg_info(
    _msg);
}

function
  _msg_info_length_got(
    _hash,
    _value) {
  const
    _msg =
      `Length for hash '${_hash}' ` +
      `is '${_value}'.`;
  _msg_info(
    _msg);
}

function
  _msg_info_lock_get(
    _hash) {
  const
    _msg =
      `Getting lock status for hash '${_hash}'.`;
  _msg_info(
    _msg);
}

function
  _msg_info_lock_got(
    _hash,
    _lock) {
  const
    _msg =
      `Locked status for hash '${_hash}' ` +
      `is '${_lock}'.`;
  _msg_info(
    _msg);
}

async function
  _lock_get(
    _lock_call_opts) {
  let
    _method_object,
    _value;
  try {
    [ _value,
      _method_object ] =
      await _contract_call_static.apply(
        null,
        _lock_call_opts);
  } catch (
      _error) {
    _error_display(
      _error);
    const
      _msg =
        "Error retrieving lock status.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  return [
    _value,
    _method_object];
}

async function
  _length_get(
    _length_call_opts) {
  let
    _method_object,
    _value;
  try {
    [ _value,
      _method_object ] =
      await _contract_call_static.apply(
        null,
        _length_call_opts);
  } catch (
      _error) {
    _error_display(
      _error);
    const
      _msg =
        "Error retrieving length.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  return [
    _value,
    _method_object];
}

function
  _lock_input_data_check(
    _files_hashes,
    _files_hashes_total,
    _files_locks_paths_total) {
  let
    _hash,
    _msg;
  if ( _files_hashes_total == 0 ) {
    _msg =
      "File hashes list empty.";
    _msg_error(
      _msg,
      1);
  }
  const
    _sha256sum_length =
      64;
  for ( _hash of _files_hashes ) {
    if ( _hash.length != _sha256sum_length ) {
      _msg =
        "Malformed SHA256 sum.";
      _msg_error(
        _msg,
        1);
    }
  }
  if ( _files_locks_paths_total > 0 ) {
    if ( _files_locks_paths_total != 
         _files_hashes_total ) {
      _msg =
        "Amount of input files hashes different " +
        "from amount of input lock files paths.";
      _msg_error(
        _msg);
    }
  }
}

function
  _length_input_data_check(
    _files_hashes,
    _files_hashes_total,
    _files_locks_paths_total,
    _files_lengths_paths_total) {
  _lock_input_data_check(
    _files_hashes,
    _files_hashes_total,
    _files_locks_paths_total);
  if ( 0 < _files_lengths_paths_total ) {
    if ( _files_lengths_paths_total != 
         _files_hashes_total ) {
      const
        _msg =
          "Amount of input files hashes different " +
          "from amount of input length files paths.";
      _msg_error(
        _msg);
    }
  }
}

async function
  _length_locked(
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _publication_namespace,
    _checkpoint_file_path,
    _files_hashes,
    _files_locks_paths) {
  let
    _cursor,
    _file_lock_path,
    _hash,
    _lock,
    _lock_call_base_opts,
    _lock_call_opts,
    _method_args,
    _msg,
    _progress;
  const
    _locks =
      [];
  if ( _method_object == undefined ) {
    _method_object =
      "";
  }
  const
    _wallet_seed_path =
      "";
  _method_object =
    "";
  _lock_call_base_opts = [
    _wallet_seed_path,
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _contract_address,
    "lock",
  ];
  const
    _method_base_args = [
      _publication_namespace,
      // _file_hash
    ];
  const
    _files_hashes_total =
      _files_hashes.length;
  const
    _files_locks_paths_total =
      _files_locks_paths.length;
  _lock_input_data_check(
    _files_hashes,
    _files_hashes_total,
    _files_locks_paths_total);
  _file_lock_path =
    "";
  _progress =
    1;
  _cursor =
    0;
  for ( _hash of _files_hashes ) {
    _msg_info_lock_get(
      _hash);
    _method_args =
      _method_base_args.concat(
        [ _hash ]
      );
    _lock_call_opts =
      _lock_call_base_opts.concat(
        [ _method_args ]);
    if ( _files_locks_paths_total > 0 ) {
      _file_lock_path =
        _files_locks_paths[
          _cursor];
    }
    try {
      [ _lock,
        _method_object ] =
        await _lock_get(
          _lock_call_opts);
      if ( _lock_call_base_opts[7] == "" ) {
        _msg =
          "Reusing contract method object.";
        _msg_info(
          _msg);
        _lock_call_base_opts = [
          _wallet_seed_path,
          _retries_max,
          _api_key_path,
          _target_network,
          _contract_abi_path,
          _contract_bytecode_path,
          _contract_compiler_output_path,
          _method_object,
          _contract_address,
          "lock",
        ];
      }
      _msg_info_lock_got(
        _hash,
        _lock);
      if ( _file_lock_path != "" ) {
        _file_write(
          _file_lock_path,
          _lock);
      }
      _file_write(
        _checkpoint_file_path,
        _hash);
    } catch (
        _error) {
      _error_display(
        _error);
      _msg =
        "Error getting lock status.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    _locks.push(
      _lock);
    _progress =
      _progress + 1;
    _cursor =
      _cursor + 1;
  }
  return [ _locks,
           _method_object ];
}

async function
  _length_lock(
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _publication_namespace,
    _checkpoint_file_path,
    _files_hashes,
    _chunks_locks_paths,
    _chunks_lengths_paths) {
  let
    _cursor,
    _files_lengths_total,
    _file_length_path,
    _hash,
    _length_call_base_opts,
    _length_call_opts,
    _lock,
    _method_args,
    _msg,
    _progress,
    _value;
  const
    _files_lengths =
      [];
  if ( _method_object === "" ||
       typeof(
         _method_object) === "undefined" ) {
    _method_object =
      {};
  }
  const
    _wallet_seed_path =
      "";
  _length_call_base_opts = [
    _wallet_seed_path,
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _contract_address,
    "getLength",
  ];
  const
    _method_base_args = [
      _publication_namespace,
      // _file_hash
    ];
  const
    _files_hashes_total =
      _files_hashes.length;
  const
    _files_locks_paths_total =
      _files_locks_paths.length;
  const
    _files_lengths_paths_total =
      _files_lengths_paths.length;
  _length_input_data_check(
    _files_hashes,
    _files_hashes_total,
    _files_locks_paths_total,
    _files_lengths_paths_total);
  _progress =
    1;
  _cursor =
    0;
  const
    _length_locked_opts = [
      _retries_max,
      _api_key_path,
      _target_network,
      _contract_address,
      _contract_abi_path,
      _contract_bytecode_path,
      _contract_compiler_output_path,
      _method_object,
      _publication_namespace,
      _checkpoint_file_path,
      _files_hashes,
      _chunks_locks_paths,
    ];
  const [
    _locks,
    _lock_method_object ] =
      await _length_locked.apply(
        null,
        _length_locked_opts);
  for ( _hash of _files_hashes ) {
    _msg_info_length_get(
      _hash,
      _progress,
      _files_hashes_total);
    _file_length_path =
      _files_lengths_paths[
        _cursor];
    _method_args =
      _method_base_args.concat(
        [ _hash ]
      );
    _length_call_opts =
      _length_call_base_opts.concat(
        [ _method_args ]);
    _lock =
      _locks[
        _cursor];
    if ( _lock == true ) {
      try {
        [ _value,
          _method_object ] =
          await _length_get(
            _length_call_opts);
        if ( _length_call_base_opts[7] == "" ) {
          _msg =
            "Reusing contract method object.";
          _msg_info(
            _msg);
          _length_call_base_opts = [
            _wallet_seed_path,
            _retries_max,
            _api_key_path,
            _target_network,
            _contract_abi_path,
            _contract_bytecode_path,
            _contract_compiler_output_path,
            _method_object,
            _contract_address,
            "getLength",
          ];
        }
        _msg_info_length_got(
          _hash,
	  _value);
        if ( _file_length_path ) {
          _file_write(
            _file_length_path,
            _value);
        }
        _file_write(
          _checkpoint_file_path,
          _hash);
        _files_lengths.push(
          _value);
      } catch (
          _error) {
        _error_display(
          _error);
        _msg =
          "Error retrieving file " +
          "length.";
        _msg_error(
          _msg,
          0);
        throw _error;
      }
    }
    else if ( _lock == false ) {
      _value =
        "";
      _files_lengths.push(
        _value);
    }
    _progress =
      _progress + 1;
    _cursor =
      _cursor + 1;
  }
  return [ _files_lengths,
           _method_object ];
}

function
  _overrides_set() {
  _override_set(
    "disk",
    "write",
    "n");
}

function
  _config_show() {
  let
    _file_hash,
    _chunks_files_paths,
    _line;
  const
    _text = [
      "  Length Lock configuration:",
      `          Maximum retries: ${retries_max}`,
      `                  API Key: ${api_key_path}`,
      `           Target network: ${target_network}`,
      `         Contract address: ${contract_address}`,
      `             Contract ABI: ${contract_abi_path}`,
      `        Contract bytecode: ${contract_bytecode_path}`,
      ` Contract compiler output: ${contract_compiler_output_path}`,
      `    Publication namespace: ${publication_namespace}`,
      `            Write to disk: ${disk_write}`,
      `          Checkpoint file: ${checkpoint_file_path}`,
      `              File hashes:`,
    ];
  for ( _file_hash of files_hashes ) {
    _text.push(
      `                           ${file_hash}`);
  }
  _files_lengths_paths =
    files_lengths_paths.join(
    " ");
  _text.push(
    `              File chunks: ${_chunks_files_paths}`);
  for ( _line of _text ) {
    _msg_info(
        _line);
  }
}

function
  _usage(
    _exit) {
  let
    _line;
  const
    _text = [
      "",
      "Check if a file length is locked.",
      "",
      "Usage:",
      `  ${app_name}`,
      "    <quiet>",
      "    <retries-max>",
      "    <api-key-path>",
      "    <target-network>",
      "    <contract-address>",
      "    <contract-abi-path>",
      "    <contract-bytecode-path>",
      "    <contract-compiler-output-path>",
      "    <publication-namespace>",
      "    <checkpoint-file-path>",
      "    <disk-write>",
      "    [file-hash]",
      "  ( [file-lock-path]",
      "    [file-length-path] )",
      "",
      "Args:",
      "  <quiet>                          Can be 'y' or 'n'",
      "                                   Default: y",
      "  <retries-max>                    Maximum number of retries before",
      "                                   failing (not implemented).",
      "  <api-key-path>                   Path of the API key for the",
      "                                   contract ABI provider service.",
      "  <target-network>                 Network on which the contract",
      "                                   resides.",
      "  <contract-address>               Address of the contract.",
      "  <contract-abi-path>              Contract ABI path.",
      "  <contract-bytecode-path>         Path for the contract bytecode.",
      "  <contract-compiler-output-path>  Path for the contract compiler",
      "                                   output path (the hardhat artifact).",
      "  <publication-namespace>          Namespace in which the file will be",
      "                                   published.",
      "  <checkpoint-file-path>           Checkpoint file on which latest",
      "                                   downloaded chunk index is saved",
      "                                   in case node was to crash.",
      "  <disk-write>                     Whether to write the query results",
      "                                   to a file.",
      "                                   Default: y",
      "  [files-hashes]                   Hashes of the files to get the",
      "                                   length and lock status of.",
      "  [files-locks-path]               Files in which to write the lock.",
      "                                   statuses.",
      "  [files-lengths-path]             Files in which to write the lengths.",
      ""
    ];
  for ( _line of _text ) {
    console.log(
      _line);
  }
  _process_exit(
    _exit);
}

function 
  _cmdline_list_args_parse(
    _list_args,
    _disk_write) {
  let
    _msg,
    _path;
  const
    _list_args_total =
      _list_args.length;
  if ( _list_args_total < 1 ) {
    const
      _msg =
        "No hashes given in input.";
    _msg_error(
      _msg,
      1)
  }
  if ( disk_write == "y" ) {
    if ( _list_args_total < 2 ) {
      _msg =
        "No lock output file specified.";
      _msg_error(
        _msg,
        1);
    }
    if ( _list_args_total < 3 ) {
      _msg =
        "No length output file specified.";
      _msg_error(
        _msg,
        1);
    }
    if ( 0 < ( _list_args_total % 3 ) ) {
      _msg =
        "Number of input hashes different " +
        "from the number of input lock and length " +
        "output files.";
      _msg_error(
        _msg,
        1);
    }
    const
      _hashes_length =
        _list_args_total / 3;
    files_hashes =
      _list_args.slice(
        0,
        _hashes_length);
    files_locks_paths =
      _list_args.slice(
        _hashes_length,
        _hashes_length * 2);
    files_lengths_paths =
      _list_args.slice(
        _hashes_length * 2,
        _hashes_length * 3);
  }
  else if ( disk_write == "n" ) {
    files_hashes =
      _list_args;
  }
  else {
    _msg =
      `Invalid value '${_disk_write}' ` +
      "for variable 'disk_write'. " +
      "Allowed values: 'y' or 'n'.";
    _msg_error(
      _msg,
      1);
  }
}

function 
  _cmdline_parse() {
  quiet = 
    "y";
  const
    _paths =
      [];
  process.argv.forEach(
    function (
      _value,
      _index,
      _array) {
      if ( _index == 2 ) {
        quiet =
          _value;
      }
      if ( _index == 3 ) {
        retries_max =
          _value;
      }
      if ( _index == 4 ) {
        api_key_path =
          _value;
      }
      if ( _index == 5 ) {
        target_network =
          _value;
      }
      if ( _index == 6 ) {
        contract_address =
          _value;
      }
      if ( _index == 7 ) {
        contract_abi_path =
          _value;
      }
      if ( _index == 8 ) {
        contract_bytecode_path =
          _value;
      }
      if ( _index == 9 ) {
        contract_compiler_output_path =
          _value;
      }
      if ( _index == 10 ) {
        publication_namespace =
          _value;
      }
      if ( _index == 11 ) {
        checkpoint_file_path =
          _value;
      }
      if ( _index == 12 ) {
        disk_write =
          _value;
      }
      if ( 12 < _index ) {
        _list_args.push(
          _value);
      }
      if ( _value == "-h" ||
           _value == "--help" ) {
        _usage(
          0);
      }
  });
  _cmdline_paths_parse(
    _list_args,
    disk_write);
  if ( file_hash == "" ||
       publication_namespace == "" ) {
    _usage(
      1);
  }
}

if ( _cmdline_check(
       "evmfs.js.lengthlock") ) {
  _global_variables();
  _cmdline_parse();
  _config_show();
  app_opts = [
    retries_max,
    api_key_path,
    target_network,
    contract_address,
    contract_abi_path,
    contract_bytecode_path,
    contract_compiler_output_path,
    method_object,
    publication_namespace,
    checkpoint_file_path,
    disk_write,
    files_hashes,
    files_locks_paths,
    files_lengths_paths
  ];
  _length_lock.apply(
    null,
    app_opts);
}

module.exports = {
  _length_locked:
    _length_locked,
  _length_lock:
    _length_lock
};
