/* eslint-disable
     no-unused-vars */

/* Crash Javascript global variables */

/* global
     quiet:
       writable */

const
  _libcrash =
    await import(
      "libcrash-js");
const
  _argv =
    _libcrash._cmdline_argv;
const
  _basename =
    _libcrash._basename;
const
  _cmdline_check =
    _libcrash._cmdline_check;
const
  _echo =
    _libcrash._echo;
const
  _echo2 =
    _libcrash._echo2;
const
  _error_display =
    _libcrash._error_display;
const
  _exit =
    _libcrash._exit;
const
  _file_write =
    _libcrash._file_write;
const
  _get =
    _libcrash._get;
const
  _global_get =
    _libcrash._global_get;
const
  _msg_info =
    _libcrash._msg_info;
const
  _msg_error =
    _libcrash._msg_error;
const
  _override_set =
    _libcrash._override_set;
const
  _require =
    _libcrash._require;
const
  _set =
    _libcrash._set;
const
  _evm_contracts_tools_module =
    await _require(
      "evm-contracts-tools");
/* global
     _contract_call_static */
const
  _contract_call_static =
    _evm_contracts_tools_module._contract_call_static;

function
  _global_variables() {
  /* global
       app_name:
         writable */
  _set(
    "app",
    "name",
    "evmfs.js.lengthlock");
  /* global
       app_opts:
         writable */
  _set(
    "app",
    "opts",
    []);
  /* global
       retries_max:
         writable */
  _set(
    "retries",
    "max",
    "");
  /* global
       api_key_path:
         writable */
  _set(
    "api_key",
    "path",
    "");
  /* global
       target_network:
         writable */
  _set(
    "target",
    "network",
    "");
  /* global
       contract_address:
         writable */
  _set(
    "contract",
    "address",
    "");
  /* global
       contract_abi_path:
         writable */
  _set(
    "contract_abi",
    "path",
    "");
  /* global
       contract_bytecode_path:
         writable */
  _set(
    "contract_bytecode",
    "path",
    "");
  /* global
       contract_compiler_output_path:
         writable */
  _set(
    "contract_compiler_output",
    "path",
    "");
  /* global
       method_object:
         writable */
  _set(
    "method",
    "object",
    "");
  /* global
       publication_namespace:
         writable */
  _set(
    "publication",
    "namespace",
    "");
  /* global
       disk_write:
         writable */
  _set(
    "disk",
    "write",
    "";
  /* global
       checkpoint_file_path:
         writable */
  _set(
    "checkpoint_file",
    "path",
    "";
  /* global
       files_hashes:
         writable */
  _set(
    "files",
    "hashes",
    []);
  /* global
       files_locks_paths:
         writable */
  _set(
    "files_locks",
    "paths",
    []);
  /* global
       files_lengths_paths:
         writable */
  _set(
    "files_length",
    "paths",
    []);
  const
    _global =
      _global_get();
  _global[
    "quiet"] =
    "";
}

function
  _msg_info_length_get(
    _hash,
    _progress,
    _total) {
  const
    _msg =
      `Getting length for hash '${_hash}' ` +
      `('${_progress}'of '${_total}').`;
  _msg_info(
    _msg);
}

function
  _msg_info_length_got(
    _hash,
    _value) {
  const
    _msg =
      `Length for hash '${_hash}' ` +
      `is '${_value}'.`;
  _msg_info(
    _msg);
}

function
  _msg_info_lock_get(
    _hash) {
  const
    _msg =
      `Getting lock status for hash '${_hash}'.`;
  _msg_info(
    _msg);
}

function
  _msg_info_lock_got(
    _hash,
    _lock) {
  const
    _msg =
      `Locked status for hash '${_hash}' ` +
      `is '${_lock}'.`;
  _msg_info(
    _msg);
}

async function
  _lock_get(
    _lock_call_opts) {
  let
    _method_object,
    _value;
  try {
    [ _value,
      _method_object ] =
      await _contract_call_static.apply(
        null,
        _lock_call_opts);
  } catch (
      _error) {
    _error_display(
      _error);
    const
      _msg =
        "Error retrieving lock status.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  return [
    _value,
    _method_object];
}

async function
  _length_get(
    _length_call_opts) {
  let
    _method_object,
    _value;
  try {
    [ _value,
      _method_object ] =
      await _contract_call_static.apply(
        null,
        _length_call_opts);
  } catch (
      _error) {
    _error_display(
      _error);
    const
      _msg =
        "Error retrieving length.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  return [
    _value,
    _method_object];
}

function
  _lock_input_data_check(
    _files_hashes,
    _files_hashes_total,
    _files_locks_paths_total) {
  let
    _hash,
    _msg;
  if ( _files_hashes_total == 0 ) {
    _msg =
      "File hashes list empty.";
    _msg_error(
      _msg,
      1);
  }
  const
    _sha256sum_length =
      64;
  for ( _hash of _files_hashes ) {
    if ( _hash.length != _sha256sum_length ) {
      _msg =
        "Malformed SHA256 sum.";
      _msg_error(
        _msg,
        1);
    }
  }
  if ( _files_locks_paths_total > 0 ) {
    if ( _files_locks_paths_total != 
         _files_hashes_total ) {
      _msg =
        "Amount of input files hashes different " +
        "from amount of input lock files paths.";
      _msg_error(
        _msg);
    }
  }
}

function
  _length_input_data_check(
    _files_hashes,
    _files_hashes_total,
    _files_locks_paths_total,
    _files_lengths_paths_total) {
  _lock_input_data_check(
    _files_hashes,
    _files_hashes_total,
    _files_locks_paths_total);
  if ( 0 < _files_lengths_paths_total ) {
    if ( _files_lengths_paths_total != 
         _files_hashes_total ) {
      const
        _msg =
          "Amount of input files hashes different " +
          "from amount of input length files paths.";
      _msg_error(
        _msg);
    }
  }
}

async function
  _length_locked(
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _publication_namespace,
    _checkpoint_file_path,
    _files_hashes,
    _files_locks_paths) {
  let
    _cursor,
    _file_lock_path,
    _hash,
    _lock,
    _lock_call_base_opts,
    _lock_call_opts,
    _method_args,
    _msg,
    _progress;
  const
    _locks =
      [];
  if ( _method_object == undefined ) {
    _method_object =
      "";
  }
  const
    _wallet_seed_path =
      "";
  _lock_call_base_opts = [
    _wallet_seed_path,
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _contract_address,
    "lock",
  ];
  const
    _method_base_args = [
      _publication_namespace,
      // _file_hash
    ];
  const
    _files_hashes_total =
      _files_hashes.length;
  const
    _files_locks_paths_total =
      _files_locks_paths.length;
  _lock_input_data_check(
    _files_hashes,
    _files_hashes_total,
    _files_locks_paths_total);
  _file_lock_path =
    "";
  _progress =
    1;
  _cursor =
    0;
  for ( _hash of _files_hashes ) {
    _msg_info_lock_get(
      _hash);
    _method_args =
      _method_base_args.concat(
        [ _hash ]
      );
    _lock_call_opts =
      _lock_call_base_opts.concat(
        [ _method_args ]);
    if ( _files_locks_paths_total > 0 ) {
      _file_lock_path =
        _files_locks_paths[
          _cursor];
    }
    try {
      [ _lock,
        _method_object ] =
        await _lock_get(
          _lock_call_opts);
      if ( _lock_call_base_opts[7] == "" ) {
        _msg =
          "Reusing contract method object.";
        _msg_info(
          _msg);
        _lock_call_base_opts = [
          _wallet_seed_path,
          _retries_max,
          _api_key_path,
          _target_network,
          _contract_abi_path,
          _contract_bytecode_path,
          _contract_compiler_output_path,
          _method_object,
          _contract_address,
          "lock",
        ];
      }
      _msg_info_lock_got(
        _hash,
        _lock);
      if ( _file_lock_path != "" ) {
        _file_write(
          _file_lock_path,
          _lock);
      }
      _file_write(
        _checkpoint_file_path,
        _hash);
    } catch (
        _error) {
      _error_display(
        _error);
      _msg =
        "Error getting lock status.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    _locks.push(
      _lock);
    _progress =
      _progress + 1;
    _cursor =
      _cursor + 1;
  }
  return [ _locks,
           _method_object ];
}

async function
  _length_lock(
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _publication_namespace,
    _checkpoint_file_path,
    _files_hashes,
    _files_locks_paths,
    _files_lengths_paths) {
  let
    _cursor,
    _files_lengths_total,
    _file_length_path,
    _hash,
    _length_call_base_opts,
    _length_call_opts,
    _lock,
    _method_args,
    _msg,
    _progress,
    _value;
  const
    _files_lengths =
      [];
  if ( _method_object === "" ||
       typeof(
         _method_object) === "undefined" ) {
    _method_object =
      {};
  }
  const
    _wallet_seed_path =
      "";
  _length_call_base_opts = [
    _wallet_seed_path,
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _contract_address,
    "getLength",
  ];
  const
    _method_base_args = [
      _publication_namespace,
      // _file_hash
    ];
  const
    _files_hashes_total =
      _files_hashes.length;
  const
    _files_locks_paths_total =
      _files_locks_paths.length;
  const
    _files_lengths_paths_total =
      _files_lengths_paths.length;
  _length_input_data_check(
    _files_hashes,
    _files_hashes_total,
    _files_locks_paths_total,
    _files_lengths_paths_total);
  _progress =
    1;
  _cursor =
    0;
  const
    _length_locked_opts = [
      _retries_max,
      _api_key_path,
      _target_network,
      _contract_address,
      _contract_abi_path,
      _contract_bytecode_path,
      _contract_compiler_output_path,
      _method_object,
      _publication_namespace,
      _checkpoint_file_path,
      _files_hashes,
      _files_locks_paths,
    ];
  const [
    _locks,
    _lock_method_object ] =
      await _length_locked.apply(
        null,
        _length_locked_opts);
  for ( _hash of _files_hashes ) {
    _msg_info_length_get(
      _hash,
      _progress,
      _files_hashes_total);
    _file_length_path =
      _files_lengths_paths[
        _cursor];
    _method_args =
      _method_base_args.concat(
        [ _hash ]
      );
    _length_call_opts =
      _length_call_base_opts.concat(
        [ _method_args ]);
    _lock =
      _locks[
        _cursor];
    if ( _lock == true ) {
      try {
        [ _value,
          _method_object ] =
          await _length_get(
            _length_call_opts);
        if ( _length_call_base_opts[7] == "" ) {
          _msg =
            "Reusing contract method object.";
          _msg_info(
            _msg);
          _length_call_base_opts = [
            _wallet_seed_path,
            _retries_max,
            _api_key_path,
            _target_network,
            _contract_abi_path,
            _contract_bytecode_path,
            _contract_compiler_output_path,
            _method_object,
            _contract_address,
            "getLength",
          ];
        }
        _msg_info_length_got(
          _hash,
	  _value);
        if ( _file_length_path ) {
          _file_write(
            _file_length_path,
            _value);
        }
        _file_write(
          _checkpoint_file_path,
          _hash);
        _files_lengths.push(
          _value);
      } catch (
          _error) {
        _error_display(
          _error);
        _msg =
          "Error retrieving file " +
          "length.";
        _msg_error(
          _msg,
          0);
        throw _error;
      }
    }
    else if ( _lock == false ) {
      _value =
        "";
      _files_lengths.push(
        _value);
    }
    _progress =
      _progress + 1;
    _cursor =
      _cursor + 1;
  }
  return [
    _files_lengths,
    _method_object
  ];
}

function
  _overrides_set() {
  _override_set(
    "disk",
    "write",
    "n");
}

function
  _config_show() {
  let
    _file_hash,
    _index,
    _length_file,
    _lock_file,
    _line;
  const
    _program =
      _basename(
        _argv[
          0]);
  const
    _text = [
      ` ${_program} configuration:`,
      `       Network settings:`,
      `          Maximum retries: ${retries_max}`,
      `                  API Key: ${api_key_path}`,
      `           Target network: ${target_network}`,
      `      Contract settings:`,
      `         Contract address: ${contract_address}`,
      `             Contract ABI: ${contract_abi_path}`,
      `        Contract bytecode: ${contract_bytecode_path}`,
      ` Contract compiler output: ${contract_compiler_output_path}`,
      `    Publication namespace: ${publication_namespace}`,
      `            Write to disk: ${disk_write}`,
      `          Checkpoint file: ${checkpoint_file_path}`,
      `              File hashes:`,
    ];
  _index =
    0;
  for ( _file_hash of files_hashes ) {
    _length_file =
      files_lengths_paths[
        _index];
    _lock_file =
      files_locks_paths[
        _index];
    _text.push(
      `                           ${_file_hash}`);
    _text.push(
      `                             lock file: ${_lock_file}`);
    _text.push(
      `                           length file: ${_length_file}`);
    _index =
      _index + 1;
  }
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
}

function
  _usage(
    _exit_code) {
  let
    _line;
  const
    _text = [
      "",
      "Checks if a file length is locked.",
      "",
      "Usage:",
      `  ${app_name}`,
      "    <quiet>",
      "    <retries-max>",
      "    <api-key-path>",
      "    <target-network>",
      "    <contract-address>",
      "    <contract-abi-path>",
      "    <contract-bytecode-path>",
      "    <contract-compiler-output-path>",
      "    <publication-namespace>",
      "    <checkpoint-file-path>",
      "    <disk-write>",
      "    [file-hash]",
      "  ( [file-lock-path]",
      "    [file-length-path] )",
      "",
      "Args:",
      "  <quiet>                          Can be 'y' or 'n'",
      "                                   Default: y",
      "  <retries-max>                    Maximum number of retries before",
      "                                   failing.",
      "  <api-key-path>                   Path of the API key for the",
      "                                   contract ABI provider service.",
      "  <target-network>                 Network on which the contract",
      "                                   resides.",
      "  <contract-address>               Address of the contract.",
      "  <contract-abi-path>              Contract ABI path.",
      "  <contract-bytecode-path>         Path for the contract bytecode.",
      "  <contract-compiler-output-path>  Path for the contract compiler",
      "                                   output path (the hardhat artifact).",
      "  <publication-namespace>          Namespace to which the file to",
      "                                   lock is published.",
      "  <checkpoint-file-path>           Checkpoint file on which latest",
      "                                   downloaded chunk index is saved",
      "                                   in case node was to crash.",
      "  <disk-write>                     Whether to write the query results",
      "                                   to a file.",
      "                                   Default: y",
      "  [files-hashes]                   Hashes of the files to get the",
      "                                   length and lock status of.",
      "  [files-locks-path]               Files in which to write the lock.",
      "                                   statuses.",
      "  [files-lengths-path]             Files in which to write the lengths.",
      ""
    ];
  for ( _line of _text ) {
    _echo(
      _line);
  }
  _exit(
    _exit_code);
}

function 
  _cmdline_list_args_parse(
    _list_args,
    _disk_write) {
  let
    _msg;
  const
    _list_args_total =
      _list_args.length;
  if ( _list_args_total < 1 ) {
    _msg =
      "No hashes given in input.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _disk_write == "y" ) {
    if ( _list_args_total < 2 ) {
      _msg =
        "No lock output file specified.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    if ( _list_args_total < 3 ) {
      _msg =
        "No length output file specified.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    if ( 0 < ( _list_args_total % 3 ) ) {
      _msg =
        "Number of input hashes different " +
        "from the number of input lock and length " +
        "output files.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    const
      _hashes_length =
        _list_args_total / 3;
    files_hashes =
      _list_args.slice(
        0,
        _hashes_length);
    files_locks_paths =
      _list_args.slice(
        _hashes_length,
        _hashes_length * 2);
    files_lengths_paths =
      _list_args.slice(
        _hashes_length * 2,
        _hashes_length * 3);
  }
  else if ( _disk_write == "n" ) {
    _files_hashes =
      _list_args;
  }
  else {
    _msg =
      `Invalid value '${_disk_write}' ` +
      "for variable '_disk_write'. " +
      "Allowed values: 'y' or 'n'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
}

function
  _cmdline_parse() {
  const
    _global =
      _global_get();
  _global[
    "quiet"] = 
    "y";
  const
    _list_args =
      [];
  _argv.forEach(
    function (
      _value,
      _index) {
      if ( _index == 2 ) {
        _global[
          "quiet"] =
          _value;
      }
      if ( _index == 3 ) {
        _set(
          "retries",
          "max",
          _value);
      }
      if ( _index == 4 ) {
        _set(
          "api_key",
          "path",
          _value);
      }
      if ( _index == 5 ) {
        _set(
          "target",
          "network",
          _value);
      }
      if ( _index == 6 ) {
        _set(
          "contract",
          "address",
          _value);
      }
      if ( _index == 7 ) {
        _set(
          "contract_abi",
          "path",
          _value);
      }
      if ( _index == 8 ) {
        _set(
          "contract_bytecode",
          "path",
          _value);
      }
      if ( _index == 9 ) {
        _set(
          "contract_compiler_output",
          "path",
          _value);
      }
      if ( _index == 10 ) {
        _set(
          "publication",
          "namespace",
          _value);
      }
      if ( _index == 11 ) {
        _set(
          "checkpoint_file",
          "path",
          _value);
      }
      if ( _index == 12 ) {
        _set(
          "disk",
          "write",
          _value);
      }
      if ( 12 < _index ) {
        _list_args.push(
          _value);
      }
      if ( _value == "-h" ||
           _value == "--help" ) {
        _global[
          "quiet"] =
          "n";
        _usage(
          0);
      }
  });
  const
    _disk_write =
      _get(
        "disk",
        "write");
  _cmdline_list_args_parse(
    _list_args,
    _disk_write);
  const
    _files_hashes =
      _get(
        "files",
        "hashes");
  const
    _publication_namespace =
      _get(
        "publication",
        "namespace");
  if ( _files_hashes.length < 1 ||
       _publication_namespace == "" ) {
    _usage(
      1);
  }
}

if ( await _cmdline_check(
       "evmfs.js.lengthlock") ) {
  let
    _msg;
  _global_variables();
  _cmdline_parse();
  _overrides_set();
  _msg =
    "Running 'chunks_lock' from command-line.";
  _msg_info(
    _msg);
  _config_show();
  app_opts = [
    retries_max,
    api_key_path,
    target_network,
    contract_address,
    contract_abi_path,
    contract_bytecode_path,
    contract_compiler_output_path,
    method_object,
    publication_namespace,
    checkpoint_file_path,
    disk_write,
    files_hashes,
    files_locks_paths,
    files_lengths_paths
  ];
  try {
    _length_lock.apply(
      null,
      app_opts);
  }
  catch(
    _error) {
    _msg =
      "Error running '_length_lock' with" +
        "arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      app_opts);
    _echo2(
      _error);
    throw _msg;
  }
}

export {
  _length_input_data_check,
  _length_lock,
  _length_locked,
  _msg_info_length_get,
};

