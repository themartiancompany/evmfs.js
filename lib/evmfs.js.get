/* eslint-disable
     no-unused-vars */

/* Crash Javascript global variables */

/* global
     quiet:
       writable */

const
  _libcrash =
    await import(
      "libcrash-js");
const
  _argv =
    _libcrash._argv;
const
  _cmdline_check =
    _libcrash._cmdline_check;
const
  _echo =
    _libcrash._echo;
const
  _echo2 =
    _libcrash._echo2;
const
  _exit =
    _libcrash._exit;
const
  _get =
    _libcrash._get;
const
  _global_get =
    _libcrash._global_get;
const
  _error_display =
    _libcrash._error_display;
const
  _file_write =
    _libcrash._file_write;
const
  _msg_info =
    _libcrash._msg_info;
const
  _msg_error =
    _libcrash._msg_error;
const
  _override_set =
    _libcrash._override_set;
const
  _set =
    _libcrash._set;
const
  _evm_contracts_tools =
    await import(
      "evm-contracts-tools");
/* global
     _contract_call_static */
const
  _contract_call_static =
    _evm_contracts_tools._contract_call_static;
const
  _commons =
    await import(
      "./commons");
const
  _chunk_file_path_check =
    _commons._chunk_file_path_check;
const
  _input_data_check =
    _commons._input_data_check;
const
  _msg_info_chunk_get =
    _commons._msg_info_chunk_get;
const
  _msg_info_chunk_got =
    _commons._msg_info_chunk_got;

function
  _global_variables() {
  /* global
       app_name:
         writable */
  _set(
    "app",
    "name",
    "evmfs.js.get");
  /* global
       app_opts:
         writable */
  _set(
    "app",
    "opts",
    []);
  /* global
       retries_max:
         writable */
  _set(
    "retries",
    "max",
    "");
  /* global
       api_key_path:
         writable */
  _set(
    "api_key",
    "path",
    "");
  /* global
       target_network:
         writable */
  _set(
    "target",
    "network",
    "");
  /* global
       contract_address:
         writable */
  _set(
    "contract",
    "address",
    "");
  /* global
       contract_abi_path:
         writable */
  _set(
    "contract_abi",
    "path",
    "");
  /* global
       contract_bytecode_path:
         writable */
  _set(
    "contract_bytecode",
    "path",
    "");
  /* global
       contract_compiler_output_path:
         writable */
  _set(
    "contract_compiler_output",
    "path",
    "");
  /* global
       method_object:
         writable */
  _set(
    "method",
    "object",
    "");
  /* global
       publication_namespace:
         writable */
  _set(
    "publication",
    "namespace",
    "");
  /* global
       file_hash:
         writable */
  _set(
    "file",
    "hash",
    "");
  /* global
       index_start:
         writable */
  _set(
    "index",
    "start",
    "");
  /* global
       index_end:
         writable */
  _set(
    "index",
    "end",
    "");
  /* global
       checkpoint_file_path:
         writable */
  _set(
    "checkpoint_file",
    "path",
    "");
  /* global
       chunks_files_paths:
         writable */
  _set(
    "chunks_files",
    "paths",
    []);
  const
    _global =
      global_get();
  global[
    "quiet"] =
    "";
}

async function
  _chunk_get(
    _read_call_opts) {
  let
    _method_object,
    _value;
  try {
    [_value,
     _method_object] =
      await _contract_call_static.apply(
        null,
        _read_call_opts);
  } catch (
      _error) {
    _error_display(
      _error);
    const
      _msg =
        "Error retrieving chunk.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  return [
    _value.toString(),
    _method_object
  ];
}

async function
  _chunks_get(
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _publication_namespace,
    _file_hash,
    _index_start,
    _index_end,
    _checkpoint_file_path,
    _chunks_files_paths
  ) {
  let
    _checkpoint_index,
    _chunk_file_path,
    _cursor,
    _read_call_base_opts,
    _read_call_opts,
    _method_args,
    _msg,
    _progress,
    _value;
  if ( typeof(
         _method_object) === "undefined" ) {
    _method_object =
      "";
  }
  const
    _wallet_seed_path =
      "";
  _read_call_base_opts = [
    _wallet_seed_path,
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _contract_address,
    "readChunk",
  ];
  const
    _method_base_args = [
      _publication_namespace,
      _file_hash
    ];
  const
    _chunks_total =
      _chunks_files_paths.length;
  _input_data_check(
    _index_start,
    _index_end,
    _chunks_total);
  _progress =
    1;
  _cursor =
    0;
  for ( var _index = _index_start;
        _index <= _index_end;
        _index++ ) {
    _msg_info_chunk_get(
      _index,
      _progress,
      _chunks_total);
    _chunk_file_path =
      _chunks_files_paths[
        _cursor];
    _chunk_file_path_check(
      _chunk_file_path,
      _index,
      _cursor);
    _method_args =
      _method_base_args.concat(
        [ _index.toString() ]
      );
    _read_call_opts =
      _read_call_base_opts.concat(
        [ _method_args ]);
    try {
      [ _value,
        _method_object ] =
        await _chunk_get(
          _read_call_opts);
      // I have no idea if _read_call_base_opts
      // has its components passed by reference
      // or copied so I have no idea if
      // _method_object gets immediately updated
      // or I need to re-init the array so just
      // in case we re-init whole array.
      if ( _read_call_base_opts[7] == "" ) {
        _msg =
          "Reusing contract method object.";
        _msg_info(
          _msg);
        _read_call_base_opts = [
          _wallet_seed_path,
          _retries_max,
          _api_key_path,
          _target_network,
          _contract_abi_path,
          _contract_bytecode_path,
          _contract_compiler_output_path,
          _method_object,
          _contract_address,
          "readChunk",
        ];
      }
      _msg_info_chunk_got(
        _index,
        _progress,
        _chunks_total);
      _file_write(
        _chunk_file_path,
        _value);
      _checkpoint_index =
        _index.toString();
      _file_write(
        _checkpoint_file_path,
        _checkpoint_index);
    } catch (
        _error) {
      _error_display(
        _error);
      _msg =
        "Error retrieving chunk.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    _progress =
      _progress + 1;
    _cursor =
      _cursor + 1;
  }
  return _method_object;
}

function
  _config_show() {
  let
    _line;
  const
    _chunks_files_paths =
      chunks_files_paths.join(
      " ");
  const
    _text = [
      `          Maximum retries: ${retries_max}`,
      `                  API Key: ${api_key_path}`,
      `           Target network: ${target_network}`,
      `         Contract address: ${contract_address}`,
      `             Contract ABI: ${contract_abi_path}`,
      `        Contract bytecode: ${contract_bytecode_path}`,
      ` Contract compiler output: ${contract_compiler_output_path}`,
      `    Publication namespace: ${publication_namespace}`,
      `                File hash: ${file_hash}`,
      `              Index start: ${index_start}`,
      `                Index end: ${index_end}`,
      `          Checkpoint file: ${checkpoint_file_path}`,
      `              File chunks: ${_chunks_files_paths}`,
    ];
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
}

function
  _usage(
    _exit_code) {
  let
    _line;
  const
    _text = [
      "Downloads chunks of an EVMFS file.",
      "",
      "Usage:",
      `  ${app_name}`,
      "    <quiet>",
      "    <retries-max>",
      "    <api-key-path>",
      "    <target-network>",
      "    <contract-address>",
      "    <contract-abi-path>",
      "    <contract-bytecode-path>",
      "    <contract-compiler-output-path>",
      "    <publication-namespace>",
      "    <index-start>",
      "    <file-hash>",
      "    <index-start>",
      "    <index-end>",
      "    <checkpoint-file-path>",
      "    [chunk-file-path]",
      "",
      "Args:",
      "  <quiet>                          Can be 'y' or 'n'",
      "                                   Default: y",
      "  <retries-max>                    Maximum number of retries before",
      "                                   failing (not implemented).",
      "  <api-key-path>                   Path of the API key for the",
      "                                   contract ABI provider service.",
      "  <target-network>                 Network on which the contract",
      "                                   resides.",
      "  <contract-address>               Address of the contract.",
      "  <contract-abi_path>              Contract ABI path.",
      "  <contract-bytecode-path>         Path for the contract bytecode.",
      "  <contract-compiler-output-path>  Path for the contract compiler",
      "                                   output path (the hardhat artifact).",
      "  <publication-namespace>          Namespace in which the file will be",
      "                                   published.",
      "  <file-hash>                      Hash of the file to publish.",
      "  <index-start>                    Chunk index from where to start.",
      "  <index-end>                      Final chunk index to download.",
      "  <checkpoint-file-path>           Checkpoint file on which latest",
      "                                   downloaded chunk index is saved",
      "                                   in case node was to crash.",
      "  [chunk-file-path]                Files in which to write the chunks.",
    ];
  for ( _line of _text ) {
    _echo(
      _line);
  }
  _exit(
    _exit_code);
}


function 
  _cmdline_parse() {
  let
    _msg;
  const
    _global =
      _global_get();
  _global[
    "quiet"] =
    "y";
  const
    _chunks_files_paths =
      _get(
        "chunks_files",
        "paths");
  _argv.forEach(
    function (
      _value,
      _index) {
      if ( _index == 2 ) {
        _global[
          "quiet"] =
          _value;
      }
      if ( _index == 3 ) {
        _set(
          "retries",
          "max",
          _value);
      }
      if ( _index == 4 ) {
        _set(
          "api_key",
          "path",
          _value);
      }
      if ( _index == 5 ) {
        _set(
          "target",
          "network",
          _value);
      }
      if ( _index == 6 ) {
        _set(
          "contract",
          "address",
          _value);
      }
      if ( _index == 7 ) {
        _set(
          "contract_abi",
          "path",
          _value);
      }
      if ( _index == 8 ) {
        _set(
          "contract_bytecode",
          "path",
          _value);
      }
      if ( _index == 9 ) {
        _set(
          "contract_compiler_output",
          "path",
          _value);
      }
      if ( _index == 10 ) {
        _set(
          "publication",
          "namespace",
          _value);
      }
      if ( _index == 11 ) {
        _set(
          "file",
          "hash",
          _value);
      }
      if ( _index == 12 ) {
        _set(
          "index",
          "start",
          _value);
      }
      if ( _index == 13 ) {
        _set(
          "index",
          "end",
          _value);
      }
      if ( _index == 14 ) {
        _set(
          "checkpoint_file",
          "path",
          _value);
      }
      if ( 14 < _index ) {
	_chunks_files_paths.push(
          _value);
      }
      if ( _value == "-h" ||
           _value == "--help" ) {
        _usage(
	  0);
      }
  });
  _set(
    "chunks_files",
    "paths",
    _chunks_files_paths);
  if ( file_hash == "" ) {
    _msg =
      "No file hash given.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
  else if (publication_namespace == "" ) {
    _msg =
      "No publication namespace given.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
}

if ( await _cmdline_check(
       "evmfs.js.get") ) {
  _global_variables();
  _cmdline_parse();
  _config_show();
  app_opts = [
    retries_max,
    api_key_path,
    target_network,
    contract_address,
    contract_abi_path,
    contract_bytecode_path,
    contract_compiler_output_path,
    method_object,
    publication_namespace,
    file_hash,
    index_start,
    index_end,
    checkpoint_file_path,
    chunks_files_paths,
  ];
  try {
    _chunks_get.apply(
      null,
      app_opts);
  }
  catch(
    _error) {
    const
      _msg =
        "Error running '_chunks_get' " +
        "with arguments:";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
}

export {
  _chunk_get,
  _chunks_get
};

