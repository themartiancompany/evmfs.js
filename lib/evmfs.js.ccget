function
  _msg_info_chunk_dereference(
    _index,
    _progress,
    _total) {
  const
    _msg =
      `Dereferencing chunk '${_index}' ` +
      `('${_progress}'of '${_total}').`;
  _msg_info(
    _msg);
}

function
  _msg_info_chunk_dereferenced(
    _index,
    _chain_id,
    _fs_address,
    _progress,
    _total) {
  const
    _template =
      `Derefereced chunk '${_index}' ` +
      `with Chain ID '${_chain_id}'` +
      `and fs address '${_fs_address}' ` +
      `('${_progress}'of '${_total}').`;
  _msg_info(
    _msg);
}

function 
  _rpc_backend_get(
    _rpcs,
    _chain_id,
    _selection_method) {
  let
    _evm_chains_rpc_backend_opts,
    _rpc;
  _rpc =
    _rpcs[
      _chain_id];
  if ( _rpc == undefined ) {
    _evm_chains_rpc_backend_opts = [
      _chain_id,
      _selection_method,
      // _evm_chains_db_path
    ];
    _rpcs[
      _chain_id] =
      _evm_chains_rpc_backend_get.apply(
        null,
        _evm_chains_rpc_backend_opts);
  }
  return _rpcs;
}

async function
  _chunk_chain_id_get(
    _retries_max,
    _read_chain_id_call_opts) {
  let
    _method_object,
    _msg,
    _passed,
    _retry,
    _value;
  _passed =
    false;
  _retry =
    1;
  while (
    _retry <= _retries_max &&
    _passed == false ) {
    try {
      _value, _method_object = 
        await _contract_call_static.apply(
          null,
          _read_chain_id_call_opts);
      if ( _value == 0 ) {
        _msg =
          "Chunk not indexed.";
        _error = {
          "error": {
            "message":
              "Chunk not indexed." } };
        throw _error;
      }
      else {
        _passed =
          true;
      }
    } catch (
        _error) {
      _error_display(
        _error);
      _msg_error(
        "Error retrieving chainID for chunk.",
        0);
      _msg =
        `Attempt '${_retry}' of '${_retries_max}'.` +
        "Retrying in 3 seconds.";
      _msg_info(
        _msg);
      _retry =
        _retry + 1;
      await _sleep(
        3000);
    }
  }
  if ( _retry > _retries_max ) {
    _msg =
      "Maximum number of retries reached.";
    _error = {
      "error": {
        "message":
          _msg } };
  }
  return [
    _value.toString(),
    _method_object ];
}

async function
  _chunk_references_no_get(
    _retries_max,
    _read_references_no_call_opts) {
  let
    _method_object,
    _msg,
    _passed,
    _retry,
    _value;
  _passed =
    false;
  _retry =
    1;
  while (
    _retry <= _retries_max &&
    _passed == false ) {
    try {
      _value, _method_object = 
        await _contract_call_static.apply(
          null,
          _read_references_no_call_opts);
      if ( _value == undefined ) {
        _error = {
          "error": {
            "message":
              "Chunk not indexed." } };
        throw _error;
      }
      _passed =
        true;
    } catch (
        _error) {
      _error_display(
        _error);
      _msg =
        "Error retrieving references amount for chunk.";
      _msg_error(
        _msg,
        0);
      _msg =
        `Attempt '${_retry}' of '${_retries_max}'. ` +
        "Retrying in 3 seconds.";
      _msg_info(
        _msg);
      _retry =
        _retry + 1;
      await _sleep(
        3000);
    }
  }
  if ( _retry > _retries_max ) {
    _msg = {
      "error": {
        "message":
          "Maximum number of retries reached." } };
    throw _error;
  }
  return [
    _value.toString(),
    _method_object ];
}

async function
  _chunk_fs_get(
    _retries_max,
    _read_fs_call_opts) {
  let
    _method_object,
    _msg,
    _passed,
    _retry,
    _value;
  _passed =
    false;
  _retry =
    1;
  while (
    _retry <= _retries_max &&
    _passed == false ) {
    try {
      _value, _method_object = 
        await _contract_call_static.apply(
          null,
          _read_fs_call_opts);
      _passed =
        true;
    } catch (
        _error) {
      _error_display(
        _error);
      _msg =
        "Error retrieving fs address for chunk.";
      _msg_error(
        _msg,
        0);
      _msg =
        `Attempt '${_retry}' of '${_retries_max}'.` +
        "Retrying in 3 seconds.";
      _msg_info(
        _msg);
      _retry =
        _retry + 1;
      await _sleep(
        3000);
    }
  }
  if ( _retry > _retries_max ) {
    _msg =
      "Maximum number of retries reached.";
    throw _msg;
  }
  return [
    _value.toString(),
    _method_object ];
}

function
  _input_data_check(
    _index_start,
    _index_end,
    _total_files) {
  let
    _msg,
    _total_indexes;
  _total_indexes =
    _index_end - _index_start + 1;
  if ( _total_files > _total_indexes ) {
    _msg =
      "More files to save into than indexes to download.";
    _msg_error(
      _msg,
      1);
  }
  if ( _total_files < _total_indexes ) {
    _msg =
      "More indexes downloads than files to save into.",
    _msg_error(
      _msg,
      1);
  }
  _msg =
    "Input data checked.";
  _msg_info(
    _msg);
}

async function
  _chain_id_read(
    _retries_max,
    _api_key_path,
    _target_network,
    _deployments_dir,
    _fs_version,
    _rpc_selection,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_objects,
    _publication_namespace,
    _file_hash,
    _index_start,
    _index_end,
    _reference) {
  let
    _chunk_chain_id,
    _chunks_chain_ids,
    _cursor,
    _method_objects_empty,
    _msg,
    _progress,
    _read_chain_id_args,
    _read_chain_id_base_args,
    _read_chain_id_call_base_opts,
    _read_chain_id_call_opts;
  const
    _wallet_seed_path =
      "";
  _msg =
    "Reading chain ID.";
  _msg_info(
    _msg);
  _index_start =
    Number(
      _index_start);
  _index_end =
    Number(
      _index_end);
  _chunks_chain_ids =
    [];
  if ( _fs_version === "" ||
       typeof(
         _fs_version) === "undefined" ) {
    // TODO:
    //   auto-detect and select highest version
    _fs_version =
      "1.0"
  }
  if ( _rpc_selection === "" ||
       typeof(
         _rpc_selection) === "undefined" ) {
    _rpc_selection =
      "kirsh"
  }
  if ( _method_objects === "" ||
       typeof(
         _method_objects) === "undefined" ) {
    _method_objects =
      {};
  }
  _method_objects_empty =
    Object.keys(
      _method_objects).length === 0
  if ( _method_objects_empty ) {
    _method_objects = {
      "ccfs": {
        "chunksChainId":
          "",
        "chunksFs":
          "",
        "chunksNo":
          "" } };
  }
  if ( _reference == undefined ) {
    _reference =
      0;
  _reference =
    Number(
      _reference);
  }
  _read_chain_id_call_base_opts = [
    _wallet_seed_path,
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_objects[
      "ccfs"][
        "chunksChainId"],
    _contract_address,
    "chunksChainId",
  ];
  _read_chain_id_base_args = [
    _publication_namespace,
    _file_hash
  ];
  _progress =
    1;
  _cursor =
    0;
  for ( var _index = _index_start;
        _index <= _index_end;
        _index++ ) {
    _msg =
      `Reading Chain ID for index ${_index}.`;
    _msg_info(
      _msg);
    _read_chain_id_args =
      _read_chain_id_base_args.concat(
        [_index.toString(),
         _reference.toString()]
      );
    _read_chain_id_call_opts =
      _read_chain_id_call_base_opts.concat(
        [_read_chain_id_args]);
    try {
      [ _chunk_chain_id,
        _method_objects[
          "ccfs"][
            "chunksChainId"] ] =
         await _chunk_chain_id_get(
          _retries_max,
          _read_chain_id_call_opts);
      // I have no idea if _check_call_base_opts
      // has its components passed by reference
      // or copied so I have no idea if
      // _method_object gets immediately updated
      // or I need to re-init the array so just
      // in case we re-init whole array.
      if ( _read_chain_id_call_base_opts[7] == "" ) {
        _msg =
          "Reusing contract method object.";
        _msg_info(
          _msg);
        _read_chain_id_call_base_opts = [
          _wallet_seed_path,
          _retries_max,
          _api_key_path,
          _target_network,
          _contract_abi_path,
          _contract_bytecode_path,
          _contract_compiler_output_path,
          _method_objects[
            "ccfs"][
              "chunksChainId"],
          _contract_address,
          "chunksChainId",
        ];
      }
      _chunks_chain_ids.append(
        _chunk_chain_id);
    } catch (
        _error) {
      _error_display(
        _error);
      _msg =
        "Error retrieving chunk's ChainId.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    _progress =
      _progress + 1;
    _cursor =
      _cursor + 1;
  }
  return [ _chunks_chain_ids,
	   _method_objects ];
}

async function
  _references_read(
    _retries_max,
    _api_key_path,
    _target_network,
    _deployments_dir,
    _fs_version,
    _rpc_selection,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_objects,
    _publication_namespace,
    _file_hash,
    _index_start,
    _index_end) {
  let
    _chain_id_read_opts,
    _chunks_no,
    _chunks_fs_addresses,
    _chunk_fs_address,
    _chunks_chain_ids,
    _chunk_chain_id,
    _chunks_references,
    _cursor,
    _fs_address_read_opts,
    _method_objects_empty,
    _msg,
    _progress,
    _read_references_args,
    _read_references_base_args,
    _read_references_call_base_opts,
    _read_references_call_opts,
    _read_references_no_args,
    _read_references_no_base_args,
    _read_references_no_call_base_opts,
    _read_references_no_call_opts;
  const
    _wallet_seed_path =
      "";
  _msg =
    "Reading File Systems pointers.";
  _msg_info(
    _msg);
  _index_start =
    Number(
      _index_start);
  _index_end =
    Number(
      _index_end);
  _chunks_references =
    [];
  if ( _rpc_selection == "" ||
       _rpc_selection == undefined ) {
    _rpc_selection =
      "kirsh"
  }
  _method_objects_empty =
    Object.keys(
      _method_objects).length === 0;
  if ( _method_objects_empty ) {
    _method_objects = {
      "ccfs": {
        "chunksChainId":
          "",
        "chunksFs":
          "",
        "chunksNo":
          "" } };
  }
  if ( _reference == undefined ) {
    _reference =
      0;
  }
  _reference =
    Number(
      _reference);
  _read_references_no_call_base_opts = [
    _wallet_seed_path,
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_objects[
      "ccfs"][
        "chunksNo"],
    _contract_address,
    "chunksNo",
  ];
  _read_references_no_base_args = [
    _publication_namespace,
    _file_hash
  ];
  _progress =
    1;
  _cursor =
    0;
  for ( var _index = _index_start;
        _index <= _index_end;
        _index++ ) {
    _msg =
      `Reading references for index ${_index}.`;
    _msg_info(
      _msg);
    _read_references_no_args =
      _read_references_no_base_args.concat(
        [ _index.toString() ]
      );
    _read_references_no_call_opts =
      _read_references_no_call_base_opts.concat(
        [ _read_references_no_args ]);
    try {
      [ _chunks_no,
        _method_objects[
          "ccfs"][
            "chunksNo"] ] =
        await _chunk_references_no_get(
          _retries_max,
          _read_references_no_call_opts);
      if ( _read_references_no_call_base_opts[7] == "" ) {
      }
    } catch (
        _error) {
      _error_display(
        _error);
      _msg =
        "Error retrieving chunk's references amount.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    // TODO:
    // get the references
    _msg =
      `Found ${_chunks_no} references.`;
    _msg_info(
      _msg);
    _chunks_no =
      Number(
        _chunks_no);
    for ( var _reference = 0;
          _reference <= _chunks_no;
          _reference++ ) {
      _msg =
        `Reading reference '${_reference}' ` +
        `for index ${_index}.`;
      _msg_info(
        _msg);
      _chain_id_read_opts = [
        _retries_max,
        _api_key_path,
        _target_network,
        _deployments_dir,
        _fs_version,
        _rpc_selection,
        _contract_address,
        _contract_abi_path,
        _contract_bytecode_path,
        _contract_compiler_output_path,
        _method_objects,
        _publication_namespace,
        _file_hash,
        _index,
        _index,
        _reference
      ];
      [ _chunks_chain_ids,
        _method_objects ] =
        await _chain_id_read.apply(
          null,
          _chain_id_read_opts);
      _chunk_chain_id =
        _chunks_chain_ids[
          0];
      _fs_address_read_opts = [
        _retries_max,
        _api_key_path,
        _target_network,
        _deployments_dir,
        _fs_version,
        _rpc_selection,
        _contract_address,
        _contract_abi_path,
        _contract_bytecode_path,
        _contract_compiler_output_path,
        _method_objects,
        _publication_namespace,
        _file_hash,
        _index,
        _index,
        _chunk_chain_id,
        _reference
      ];
      [ _chunks_fs_addresses,
        _method_objects ] =
        await _fs_address_read.apply(
          null,
          _fs_address_read_opts);
      _chunk_fs_address =
        _chunks_fs_addresses[0];
      _chunks_references.append(
        [ _chunk_chain_id,
          _chunk_fs_address ] );
    }
    _progress =
      _progress + 1;
    _cursor =
      _cursor + 1;
  }
  return [ _chunks_references,
           _method_objects ];
}

async function
  _fs_address_read(
    _retries_max,
    _api_key_path,
    _target_network,
    _deployments_dir,
    _fs_version,
    _rpc_selection,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_objects,
    _publication_namespace,
    _file_hash,
    _index_start,
    _index_end,
    _chunk_chain_id,
    _reference) {
  let
    _chunks_fs_addresses,
    _cursor,
    _msg,
    _progress,
    _read_fs_args,
    _read_fs_call_opts;
  // Force unauthenticated call
  // for now.
  const
    _wallet_seed_path =
      "";
  _msg =
    "Reading File Systems addresses.";
  _msg_info(
    _msg);
  _index_start =
    Number(
      _index_start);
  _index_end =
    Number(
      _index_end);
  _chunks_chain_ids =
    [];
  if ( _rpc_selection == "" ||
       typeof(
         _rpc_selection) === "undefined" ) {
    _rpc_selection =
      "kirsh";
  }
  _method_objects_empty =
    Object.keys(
      _method_objects).length === 0;
  if ( _method_objects_empty ) {
    _method_objects = {
      "ccfs": {
        "chunksChainId":
          "",
        "chunksFs":
          "",
        "chunksNo":
          "" } };
  }
  if ( _reference == undefined ) {
    _reference =
      0;
  }
  _reference =
    Number(
      _reference);
  const
    _wallet_seed_path =
      "";
  const
    _read_fs_call_base_opts = [
      _wallet_seed_path,
      _retries_max,
      _api_key_path,
      _target_network,
      _contract_abi_path,
      _contract_bytecode_path,
      _contract_compiler_output_path,
      _method_objects[
        "ccfs"][
          "chunksFs"],
      _contract_address,
      "chunksFs",
    ];
  const
    _read_fs_base_args = [
      _publication_namespace,
      _file_hash
    ];
  _progress =
    1;
  _cursor =
    0;
  for ( var _index = _index_start;
        _index <= _index_end;
        _index++ ) {
    _msg =
      `Reading Chain ID for index ${_index}.`;
    _msg_info(
      _msg);
    _read_fs_args =
      _read_fs_base_args.concat(
        [_index.toString(),
         _reference.toString(),
         _chunk_chain_id]
      );
    _read_fs_call_opts =
      _read_fs_call_base_opts.concat(
        [_read_fs_args]);
    try {
      [ _chunk_fs,
        _method_objects[
          "ccfs"][
            "chunksFs"] ] =
        await _chunk_fs_get(
          _retries_max,
          _read_fs_call_opts);
      if ( _read_fs_call_base_opts[7] == "" ) {
      }
    } catch (
        _error) {
      _display_error(
        _error);
      _msg =
        "Error retrieving chunk's fs address.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    _progress =
      _progress + 1;
    _cursor =
      _cursor + 1;
  }
  return [ _chunks_chain_ids,
	   _method_objects ];
}

async function
  _ccget(
    _retries_max,
    _api_key_path,
    _target_network,
    _deployments_dir,
    _fs_version,
    _rpc_selection,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_objects,
    _publication_namespace,
    _file_hash,
    _index_start,
    _index_end,
    _checkpoint_file_path,
    _chunks_files_paths
  ) {
  let
    _chunk_chain_id,
    _chunk_file_path,
    _chunk_fs,
    _chunks_total,
    _cursor,
    _fs_contract_abi_path,
    _fs_contract_bytecode_path,
    _fs_contract_compiler_output_path,
    _get_opts,
    _msg,
    _reference,
    _rpcs,
    _rpc_backend,
    _progress,
    _value,
    _wallet_seed_path;
  _method_objects_empty =
    Object.keys(
      _method_objects).length === 0
  if ( _method_objects_empty ) {
    _method_objects = {
      "ccfs": {
        "chunksChainId":
          "",
        "chunksFs":
          "",
        "chunksNo":
          "" } };
  }
  _index_start =
    Number(
      _index_start);
  _index_end =
    Number(
      _index_end);
  if ( _rpc_selection == "" ||
       _rpc_selection == undefined ) {
    _rpc_selection =
      "kirsh"
  }
  if ( _rpcs == undefined ) {
    _rpcs =
      {};
  }
  _get_opts =
    [];
  _wallet_seed_path =
    "";
  _chunks_total =
    _chunks_files_paths.length;
  if ( _chunks_total == 0 ) {
    _msg =
      "File chunks list empty.";
    _msg_error(
      _msg,
      1);
  }
  _input_data_check(
    _index_start,
    _index_end,
    _chunks_total);
  _progress =
    1;
  _cursor =
    0;
  for ( var _index = _index_start;
        _index <= _index_end;
        _index++ ) {
    _msg_info_chunk_dereference(
      _index,
      _progress,
      _chunks_total);
    _chunk_file_path =
      _chunks_files_paths[
        _cursor];
    // Users can provide
    // multiple references for
    // redundancy though, but for
    // now we just select the kirsh
    // one. This capability will be
    // needed when implementing
    // the crowd-sourced upload
    _references_read_opts = [
      _retries_max,
      _api_key_path,
      _target_network,
      _deployments_dir,
      _fs_version,
      _rpc_selection,
      _contract_address,
      _contract_abi_path,
      _contract_bytecode_path,
      _contract_compiler_output_path,
      _method_objects,
      _publication_namespace,
      _file_hash,
      _index,
      _index
    ];
    _chunk_references =
      await _references_read.apply(
        null,
        _references_read_opts);
    _reference =
      0;
    [ _chunk_chain_id,
      _chunk_fs ] =
      _chunks_references[
        _reference];
    _msg_info_chunk_dereferenced(
      _index,
      _chunk_chain_id,
      _chunk_fs,
      _progress,
      _chunks_total);
    _fs_contract_abi_path =
      _contract_abi_get(
        _deployments_dir,
        "FileSystem",
        _chunk_chain_id,
        _fs_version);
    _fs_contract_bytecode_path =
      _contract_bytecode_get(
        _deployments_dir,
        "FileSystem",
        _chunk_chain_id,
        _fs_version);
    _fs_contract_compiler_output_path =
      _contract_compiler_output_get(
        _deployments_dir,
        "FileSystem",
        _chunk_chain_id,
        _fs_version);
    _rpcs =
      _rpc_backend_get(
        _rpcs,
        _chunk_chain_id,
        _rpc_selection);
    _rpc_backend =
      _rpcs[
        _chunk_chain_id];
    _get_opts = [
      _retries_max,
      _api_key_path,
      _rpc_backend,
      _chunk_fs,
      _fs_contract_abi_path,
      _fs_contract_bytecode_path,
      _fs_contract_compiler_output_path,
      _method_objects[
        "fs"][
          _chunk_chain_id][
            _chunk_fs],
      _publication_namespace,
      _file_hash,
      _index,
      _index,
      _checkpoint_file_path,
      [ _chunk_file_path ]
    ];
    try {
      _method_objects[
        "fs"][
          _chunk_chain_id][
            _chunk_fs] =
        await _get.apply(
          null,
          _get_opts);
      if ( _get_opts[7] == undefined ||
           _get_opts[7] == "" ) {
        // I have no idea if _read_call_base_opts
        // has its components passed by reference
        // or copied so I have no idea if
        // _method_object gets immediately updated
        // or I need to re-init the array so just
        // in case we re-init whole array.
        _msg =
          "Reusing contract method object.";
        _msg_info(
          _msg);
        _get_opts = [
          _retries_max,
          _api_key_path,
          _rpc_backend,
          _chunk_fs,
          _fs_contract_abi_path,
          _fs_contract_bytecode_path,
          _fs_contract_compiler_output_path,
          _method_objects[
            "fs"][
              _chunk_chain_id][
                _chunk_fs],
          _publication_namespace,
          _file_hash,
          _index,
          _index,
          _checkpoint_file_path,
          [ _chunk_file_path ]
        ];
      }
    } catch (
        _error) {
      _error_display(
        _error);
      _msg =
        "Error retrieving chunk.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    _progress =
      _progress + 1;
    _cursor =
      _cursor + 1;
  }
  return _method_objects;
}

function
  _overrides_set() {
  _override_set(
    "fs",
    "version",
    "1.0");
  if ( rpc_selection == "" ) {
    rpc_selection =
      "kirsh";
  }
}

function
  _config_show() {
  let
    _line;
  const
    _chunks_files_paths =
      chunks_files_paths.join(
      " ");
  const
    _text = [
      `          Maximum retries: ${retries_max}`,
      `                  API Key: ${api_key_path}`,
      `           Target network: ${target_network}`,
      `          Deployments dir: ${deployments_dir}`,
      `      File System version: ${fs_version}`,
      `            RPC selection: ${rpc_selection}`,
      `         Contract address: ${contract_address}`,
      `             Contract ABI: ${contract_abi_path}`,
      `        Contract bytecode: ${contract_bytecode_path}`,
      ` Contract compiler output: ${contract_compiler_output_path}`,
      `    Publication namespace: ${publication_namespace}`,
      `                File hash: ${file_hash}`,
      `              Index start: ${index_start}`,
      `                Index end: ${index_end}`,
      `          Checkpoint file: ${checkpoint_file_path}`,
      `              File chunks: ${_chunks_files_paths}`,
    ];
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
}

function
  _usage(
    _exit) {
  const
    _text = [
      "Downloads chunks of an EVMFS file.",
      "",
      "Usage:",
      "  ccget",
      "    <quiet>",
      "    <retries-max>",
      "    <api-key-path>",
      "    <target-network>",
      "    <deployments-dir>",
      "    <fs-version>",
      "    <rpc-selection>",
      "    <contract-address>",
      "    <contract-abi-path>",
      "    <contract-bytecode-path>",
      "    <contract-compiler-output-path>",
      "    <publication-namespace>",
      "    <index-start>",
      "    <file-hash>",
      "    <index-start>",
      "    <index-end>",
      "    <checkpoint-file-path>",
      "    [chunk-file-path]",
      "",
      "Args:",
      "  <quiet>                          Can be 'y' or 'n'",
      "                                   Default: y",
      "  <retries-max>                    Maximum number of retries before",
      "                                   failing (not implemented).",
      "  <api-key-path>                   Path of the API key for the",
      "                                   contract ABI provider service.",
      "  <target-network>                 Network on which the contract",
      "                                   resides.",
      "  <deployments-dir>                Contracts deployments directory.",
      "  <fs-version>                     Version of the target file",
      "                                   system contract.",
      "                                   Default: 1.0",
      "  <rpc-selection>                  RPC selection method.",
      "                                   Default: kirsh",
      "  <contract-address>               Address of the contract.",
      "  <contract-abi-path>              Contract ABI path.",
      "  <contract-bytecode-path>         Path for the contract bytecode.",
      "  <contract-compiler-output-path>  Path for the contract compiler",
      "                                   output path (the hardhat artifact).",
      "  <publication-namespace>          Namespace in which the file will be",
      "                                   published.",
      "  <file-hash>                      Hash of the file to publish.",
      "  <index-start>                    Chunk index from where to start.",
      "  <index-end>                      Final chunk index to download.",
      "  <checkpoint-file-path>           Checkpoint file on which latest",
      "                                   downloaded chunk index is saved",
      "                                   in case node was to crash.",
      "  [chunk-file-path]                Files in which to write the chunks.",
    ];
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
  _process_exit(
    _exit);
}


function 
  _cmdline_parse() {
  quiet = 
    "y";
  process.argv.forEach(
    function (
      _value,
      _index,
      _array) {
      if ( _index == 2 ) {
        quiet =
          _value;
      }
      if ( _index == 3 ) {
        retries_max =
          _value;
      }
      if ( _index == 4 ) {
        api_key_path =
          _value;
      }
      if ( _index == 5 ) {
        target_network =
          _value;
      }
      if ( _index == 6 ) {
        deployments_dir =
          _value;
      }
      if ( _index == 7 ) {
        fs_version =
          _value;
      }
      if ( _index == 8 ) {
        rpc_selection =
          _value;
      }
      if ( _index == 9 ) {
        contract_address =
          _value;
      }
      if ( _index == 10 ) {
        contract_abi_path =
          _value;
      }
      if ( _index == 11 ) {
        contract_bytecode_path =
          _value;
      }
      if ( _index == 12 ) {
        contract_compiler_output_path =
          _value;
      }
      if ( _index == 13 ) {
        publication_namespace =
          _value;
      }
      if ( _index == 14 ) {
        file_hash =
          _value;
      }
      if ( _index == 15 ) {
        index_start =
          _value;
      }
      if ( _index == 16 ) {
        index_end =
          _value;
      }
      if ( _index == 17 ) {
        checkpoint_file_path =
          _value;
      }
      if ( 17 < _index ) {
        chunks_files_paths.push(
          _value);
      }
      if ( _value == "-h" ||
           _value == "--help" ) {
        _usage(
	  0);
      }
  });
  if ( file_hash == "" ||
       publication_namespace == "" ) {
    _usage(
      1);
  }
}

if ( _cmdline_check(
       "evmfs.js.ccget") ) {
  _global_variables();
  _cmdline_parse();
  _overrides_set();
  _config_show();
  app_opts = [
    retries_max,
    api_key_path,
    target_network,
    deployments_dir,
    fs_version,
    rpc_selection,
    contract_address,
    contract_abi_path,
    contract_bytecode_path,
    contract_compiler_output_path,
    method_objects,
    publication_namespace,
    file_hash,
    index_start,
    index_end,
    checkpoint_file_path,
    chunks_files_paths,
  ];
  _ccget.apply(
    null,
    app_opts);
}

module.exports = {
  _chain_id_read:
    _chain_id_read,
  _fs_address_read:
    _fs_address_read,
  _ccget:
    _ccget,
  _references_read:
    _references_read
};
