function
  _msg_info_chunk_publish(
    _index,
    _progress,
    _total) {
  const
    _msg =
      `Publishing chunk '${_index}' ` +
      `('${_progress}'of '${_total}').`;
  _msg_info(
    _msg);
}

function
  _msg_info_chunk_unpublished(
    _index,
    _progress,
    _total) {
  const
    _msg =
      `Chunk '${_index}' unpublished, ` +
      `publishing now ('${_progress}' of ` +
      `'${_total}').`;
  _msg_info(
    _msg);
}

async function
  _chunk_publish(
    _contract_run_opts) {
  let
    _tx;
  try {
    _tx = await
      _contract_run.apply(
        null,
        _contract_run_opts);
  } catch(
      _error) {
    _error_display(
      _error);
    const
      _msg =
        "Error publishing the chunk.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  return _tx;
}

function
  _input_data_check(
    _index_start,
    _index_end,
    _total_chunks) {
  let
    _msg;
  const
    _total_indexes =
      _index_end - _index_start + 1;
  if ( _total_chunks > _total_indexes ) {
    _msg =
      `More chunks files to upload ` +
      `(${_total_chunks}) than indexes ` +
      `to upload (${_total_indexes}).`;
    _msg_error(
      _msg,
      1);
  }
  if ( _total_chunks < _total_indexes ) {
    _msg =
      `More indexes' upload ` +
      `(${_total_indexes}) than ` +
      `chunks files to upload (${_total_chunks}).`;
    _msg_error(
      _msg,
      1);
  }
  _msg =
    "Input data checked.";
  _msg_info(
    _msg);
}

function
  _chunk_file_path_check(
    _path,
    _index,
    _cursor) {
  let
    _msg;
  if ( _path == undefined ) {
    _msg =
      "Chunk file for " +
      `index '${_index}' and ` +
      `cursor '${_cursor}' undefined.`;
    _msg_error(
      _msg,
      1);
  }
}

function
  _chunks_files_paths_prefix_get(
    _chunks_unverified) {
  let
    _chunks_files_paths_prefix,
    _msg;
  if ( _chunks_unverified.length != 0 ) {
    if ( _chunks_unverified[0] == undefined ) {
      _msg =
        "Weird error.";
      _msg_error(
        _msg,
        1);
    }
    else if ( _chunks_unverified[0].length != 0 ) {
      _chunks_files_paths_prefix =
        _ext_rm(
          _chunks_unverified[
            0][
              1]);
    }
  }
  else if ( _chunks_unverified.length == 0 ) {
    _msg =
      "File already published.";
    _msg_info(
      _msg);
  }
  return _chunks_files_paths_prefix;
}

async function
  _chunks_publish(
    _retries_max,
    _call_timeout,
    _wallet_seed_path,
    _api_key_path,
    _target_network,
    _contract_address,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _publication_namespace,
    _file_hash,
    _index_start,
    _index_end,
    _checkpoint_file_path,
    _chunks_files_paths) {
  let
    _check_call_base_opts,
    _check_call_opts,
    _checkpoint_index,
    _chunk,
    _chunk_check_args,
    _chunk_file_path,
    _chunk_publish_args,
    _chunks_files_paths_prefix,
    _cursor,
    _index,
    _method_object,
    _msg,
    _progress,
    _publish_call_opts,
    _published,
    _tx;
  const
    _chunks_unverified =
      [];
  const
    _indexes_unverified =
      [];
  if ( _call_timeout == "" ) {
    _call_timeout =
      300000;
  }
  _call_timeout =
    Number(
      _call_timeout);
  _index_start =
    Number(
      _index_start);
  _index_end =
    Number(
      _index_end);
  _method_object =
    "";
  const
    _wallet_password =
      "";
  _check_call_base_opts = [
    "", // _wallet_seed_path,
    _retries_max,
    _api_key_path,
    _target_network,
    _contract_abi_path,
    _contract_bytecode_path,
    _contract_compiler_output_path,
    _method_object,
    _contract_address,
    "chunks",
  ];
  const
    _publish_call_base_opts = [
      _retries_max,
      _call_timeout,
      _wallet_seed_path,
      _wallet_password,
      _api_key_path,
      "auto",   // <---------    Price selection mode:
                //               It can be 'auto',
                //               'fast', 'nextblock' or an
                //               integer directly.
      0,
      "wei",
      _target_network,
      _contract_address,
      _contract_abi_path,
      _contract_bytecode_path,
      _contract_compiler_output_path,
      "publishChunk",
    ];
  const
    _method_base_args = [
      _publication_namespace,
      _file_hash
    ];
  const
    _chunks_total =
      _chunks_files_paths.length;
  if ( _chunks_total == 0 ) {
    _msg =
      "File chunks list empty.";
    _msg_error(
      _msg,
      1);
  }
  _input_data_check(
    _index_start,
    _index_end,
    _chunks_total);
  _progress =
    1;
  _cursor =
    0;
  for ( _index = _index_start;
        _index <= _index_end;
        _index++ ) {
    _msg_info_chunk_publish(
      _index,
      _progress,
      _chunks_total);
    _chunk_file_path =
      _chunks_files_paths[
        _cursor];
    _chunk_file_path_check(
      _chunk_file_path,
      _index,
      _cursor);
    _chunk =
      _file_read(
        _chunk_file_path);
    _chunk_check_args =
      _method_base_args.concat([
        _index.toString()
      ]);
    _check_call_opts =
      _check_call_base_opts.concat([
        _chunk_check_args
      ]);
    try {
      [ _published,
        _method_object ] =
        await _chunk_check(
          _chunk,
          _check_call_opts);
      // I have no idea if _check_call_base_opts
      // has its components passed by reference
      // or copied so I have no idea if
      // _method_object gets immediately updated
      // or I need to re-init the array so just
      // in case we re-init whole array.
      if ( _check_call_base_opts[7] == "" ) {
        _msg =
          "Reusing contract method object.";
        _msg_info(
          _msg);
        _check_call_base_opts = [
          "", // _wallet_seed_path,
          _retries_max,
          _api_key_path,
          _target_network,
          _contract_abi_path,
          _contract_bytecode_path,
          _contract_compiler_output_path,
          _method_object,
          _contract_address,
          "chunks",
        ];
      }
    } catch (
        _error) {
      _error_display(
        _error);
      _msg =
        "Error checking publication status.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    if ( _published == true ) {
      _msg_info_chunk_published_already(
        _index,
        _progress,
        _chunks_total);
    }
    else if ( _published == false ) {
      _msg_info_chunk_unpublished(
        _index,
        _progress,
        _chunks_total);
      _chunk_publish_args =
        _method_base_args.concat(
          [_index.toString(),
           _chunk]);
      _publish_call_opts =
        _publish_call_base_opts.concat(
          [_chunk_publish_args]);
      try {
        _tx = await
          _chunk_publish(
            _publish_call_opts);
      } catch (
          _error) {
        _error_display(
          _error);
        _msg =
          "Error running publishing chunk function.";
        _msg_error(
          _msg,
          0);
        throw _error;
      }
      _msg_info_chunk_published(
        _tx,
        _index,
        _progress,
        _chunks_total);
      _chunks_unverified.push([
        _index,
        _chunk_file_path
      ]);
    }
    else {
      _msg =
        "Unexpected chunk publication status value:";
      _msg_error(
        _msg,
        0);
      _echo2(
        _published);
      const
        _error = {
          "error": {
            "message":
              _msg } };
      throw _error;
    }
    _checkpoint_index =
      _index.toString();
    _file_write(
      _checkpoint_file_path,
      _checkpoint_index);
    _progress =
      _progress + 1;
    _cursor =
      _cursor + 1;
  }
  if ( _chunks_unverified.length != 0 ) {
    _chunks_files_paths_prefix =
      _chunks_files_paths_prefix_get(
        _chunks_unverified);
    for ( _chunk of _chunks_unverified ) {
      _indexes_unverified.push(
        _chunk[
          0]);
    }
  }
  if ( 0 < _indexes_unverified.length ) {
    _msg =
      "There is a total of " +
      `'${_indexes_unverified.length}' indexes ` +
      `left to verify. Expected prefix ` +
      `'${_chunks_files_paths_prefix}'.`;
    _msg_info(
      _msg);
    // _verify(
    //   _retries_max,
    //   _api_key_path,
    //   _target_network,
    //   _contract_address,
    //   _contract_abi_path,
    //   _contract_bytecode_path,
    //   _contract_compiler_output_path,
    //   _publication_namespace,
    //   _file_hash,
    //   _chunks_files_paths_prefix,
    //   _indexes_unverified); 
  }
  else if ( _indexes_unverified.length == 0 ) {
    _msg =
      "All chunks already verified.";
    _msg_info(
      _msg);
    _checkpoint_index =
      _index_end.toString();
    _file_write(
      _checkpoint_file_path,
      _checkpoint_index);
  }
  return _chunks_unverified;
}

function
  _config_show() {
  let
    _chunks_files_paths,
    _line;
  const
    _program =
      _basename(
        _argv[
          0]);
  const
    _chars_max =
      300;
  _chunks_files_paths =
    chunks_files_paths.join(
    " ");
  if ( _chars_max < _chunks_files_paths.length ) {
    _chunks_files_paths =
      _chunks_files_paths.substring(
        0,
	_chars_max);
  }
  const
    _text = [
      ` ${_program} configuration:`,
      `                File hash: ${file_hash}`,
      `    Publication namespace: ${publication_namespace}`,
      `   Credentials settings:`,
      `              Wallet seed: ${wallet_seed_path}`,
      `       Network settings:`,
      `           Target network: ${target_network}`,
      `                  API Key: ${api_key_path}`,
      `             Call timeout: ${call_timeout}`,
      `          Maximum retries: ${retries_max}`,
      `      Contract settings:`,
      `         Contract address: ${contract_address}`,
      `             Contract ABI: ${contract_abi_path}`,
      `        Contract bytecode: ${contract_bytecode_path}`,
      ` Contract compiler output: ${contract_compiler_output_path}`,
      `       Session settings:`,
      `              Index start: ${index_start}`,
      `                Index end: ${index_end}`,
      `          Checkpoint file: ${checkpoint_file_path}`,
      `              File chunks: ${_chunks_files_paths}`
    ];
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
}

function
  _usage(
    _exit_code) {
  let
    _line;
  const
    _program =
      _basename(
        _argv[
          0];
  const
    _text = [
      "",
      "Publishes chunks of an EVMFS file.",
      "",
      "Usage:",
      `  ${_program}`,
      "    <quiet>",
      "    <retries-max>",
      "    <call-timeout>",
      "    <wallet-seed-path>",
      "    <api-key-path>",
      "    <target-network>",
      "    <contract-address>",
      "    <contract-abi-path>",
      "    <contract-bytecode-path>",
      "    <contract-compiler-output-path>",
      "    <publication-namespace>",
      "    <file-hash>",
      "    <index-start>",
      "    <index-end>",
      "    <checkpoint-file-path>",
      "    [chunk-file-path]",
      "",
      "Args:",
      "  <quiet>                          Can be 'y' or 'n'",
      "                                   Default: y",
      "  <retries-max>                    Maximum number of retries before",
      "                                   failing.",
      "  <call-timeout>                   How many milliseconds to wait",
      "                                   for a return before declaring",
      "                                   the call failed.",
      `                                   Default: ${call_timeout}`,

      "  <wallet-seed-path>               Path of the file containing",
      "                                   the seed phrase.",
      "  <api-key-path>                   Path of the API key for the",
      "                                   contract ABI provider service.",
      "  <target-network>                 Network on which the contract",
      "                                   resides.",
      "  <contract-address>               Address of the contract.",
      "  <contract-abi-path>              Contract ABI path.",
      "  <contract-bytecode-path>         Path for the contract bytecode.",
      "  <contract-compiler-output-path>  Path for the contract compiler",
      "                                   output path (the hardhat artifact).",
      "  <publication-namespace>          Namespace in which the file will be",
      "                                   published.",
      "  <file-hash>                      Hash of the file to publish.",
      "  <index-start>                    Chunk index from where to start.",
      "  <index-end>                      Final chunk index to publish.",
      "  <checkpoint-file-path>           Checkpoint file on which latest",
      "                                   current published chunk index is saved",
      "                                   in case node was to crash.",
      "  <chunks-files-type>              Can be 'file' or 'list. If file",
      "                                   it will consider the next arguments",
      "                                   files, if 'list' it the next argument",
      "                                   will be considered a JSON list",
      "                                   containing the files paths.",
      "  [chunks-files-paths]             File chunks to publish.",
    ];
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
  _exit(
    _exit_code);
}

function
  _cmdline_parse() {
  let
    _msg;
  const
    _global =
      _global_get();
  _global[
    "quiet"] = 
    "y";
  const =
    _chunks_files_paths =
      _get(
        "_chunks_files",
        "paths");
  _argv.forEach(
    function (
      _value,
      _index) {
      if ( _index == 2 ) {
        _global[
          "quiet"] =
          _value;
      }
      if ( _index == 3 ) {
        _set(
          "retries",
          "max",
          _value);
      }
      if ( _index == 4 ) {
        _set(
          "call",
          "timeout",
          _value);
      }
      if ( _index == 5 ) {
        _set(
          "wallet_seed",
          "path",
          _value);
      }
      if ( _index == 6 ) {
        _set(
          "api_key",
          "path",
          _value);
      }
      if ( _index == 7 ) {
        _set(
          "target",
          "network",
          _value);
      }
      if ( _index == 8 ) {
        _set(
          "contract",
          "address",
          _value;
      }
      if ( _index == 9 ) {
        _set(
          "contract_abi",
          "path",
          _value;
      }
      if ( _index == 10 ) {
        _set(
          "contract_bytecode",
          "path",
          _value);
      }
      if ( _index == 11 ) {
        _set(
          "contract_compiler_output",
          "path",
          _value);
      }
      if ( _index == 12 ) {
        _set(
          "publication",
          "namespace",
          _value);
      }
      if ( _index == 13 ) {
        _set(
          "file",
          "hash",
          _value);
      }
      if ( _index == 14 ) {
        _set(
          "index",
          "start",
          _value);
      }
      if ( _index == 15 ) {
        _set(
          "index",
          "end",
          _value);
      }
      if ( _index == 16 ) {
        _set(
          "checkpoint_file",
          "path",
          _value);
      }
      if ( _index == 17) {
        _set(
          "chunks_files",
          "type",
          _value);
      }
      if ( 17 < _index ) {
        _chunks_files_paths.push(
          _value);
      }
      if ( _value == "-h" ||
           _value == "--help" ) {
        _global[
          "quiet"] =
          "n";
        _usage(
          0);
      }
  });
  const
    _file_hash =
      _get(
        "file",
        "hash");
  if ( _file_hash == "" ) {
    _global[
      "quiet"] =
      "n";
    _msg =
      "No file hash given.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
  const
    _publication_namespace =
      _get(
        "publication",
        "namespace");
  if ( _publication_namespace == "" ) {
    _global[
      "quiet"] =
    _msg =
      "No publication namespace given.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
  if ( chunks_files_paths == [] ) {
    _global[
      "quiet"] =
      "n";
    _msg =
      "No chunks files paths given.";
    _msg_error(
      _msg,
      0);
    _usage(
      1);
  }
}

async function
  _publish_cmdline(
    _app_opts) {
  let
    _msg;
  try {
    const
      _chunks_unverified =
        await _publish.apply(
          null,
          _app_opts);
    if ( 0 < _chunks_unverified.length ) {
      _msg =
        `Left '${_chunks_unverified.length}' ` +
        `chunks to verify.`;
      _msg_info(
        _msg);
    }
  } catch (
      _error) {
    _msg =
      "Publication error.";
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
}

function
  _overrides_set() {
  _override_set(
    "call",
    "timeout",
    300000);
  _override_set(
    "chunks_files",
    "type",
    "file");
  if ( chunks_files_type == "list" ) {
    chunks_files_paths =
      _json_read(
        chunks_files_paths[
          0]
      );
  }
  _override_set(
    "retries",
    "max",
    3);
}

if ( await _cmdline_check(
       "evmfs.js.publish") ) {
  _global_variables();
  _cmdline_parse();
  _overrides_set();
  _config_show();
  const
    _msg =
      "Running 'chunks_publish' from command-line.";
  _msg_info(
    _msg);
  app_opts = [
    retries_max,
    call_timeout,
    wallet_seed_path,
    api_key_path,
    target_network,
    contract_address,
    contract_abi_path,
    contract_bytecode_path,
    contract_compiler_output_path,
    publication_namespace,
    file_hash,
    index_start,
    index_end,
    checkpoint_file_path,
    chunks_files_paths,
  ];
  try {
    _publish_cmdline(
      app_opts);
  }
  catch(
    _error) {
    const
      _msg =
        "Error running '_publish_cmdline' with" +
        "arguments:";
    _msg_error(
      _msg,
      0);
    _echo2(
      app_opts);
    _echo2(
      _error);
    throw _msg;
  }
}

export {
  _chunk_publish,
  _chunks_files_paths_prefix_get,
  _chunks_publish,
  _input_data_check,
  _msg_info_chunk_published,
  _msg_info_chunk_published_already,
  _msg_info_chunk_unpublished,
};

