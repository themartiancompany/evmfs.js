async function
  _namespace_setup(
    _namespace) {
  let
    _msg,
    _namespace_get;
  _namespace_get =
    false;
  const
    _namespace_type =
      typeof(
        _namespace);
  if ( _namespace_type === "undefined"  ) {
    _msg =
      "Namespace is undefined, setting " +
      "own.";
    _msg_info(
      _msg);
    _namespace_get =
      true;
  }
  if ( _namespace_type === "string"  ) {
    if ( _namespace.length < 1 ) {
      _msg =
        "Namespace is an empty string, " +
        "setting own.";
      _msg_info(
        _msg);
      _namespace_get =
        true;
    }
  }
  else if ( _namespace_type === "object"  ) {
    _msg =
      "Seed system support is for a later version.";
    _msg_info(
      _msg);
    _namespace_get =
      true;
  }
  else {
    _msg =
      `Unknown type '${_namespace_type}' for ` +
      "namespace variable.";
    _msg_error(
      _msg,
      0);
  }
  if ( _namespace_get ) {
    const
      _address_get_args = [
        _wallet_seed,
        "",                  // network
        "",                  // api key
        "",                  // chain id
        "",                  // chain name
        ""                   // output file
      ];
    try {
      _namespace =
        await _address_get.apply(
          null,
          _address_get_args);
    }
    catch(
      _error) {
      _msg =
        "Error getting address for " +
        "own address.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
  }
  return _namespace;
}

async function
  _evmfs_get(
    _fs_address,
    _ll_address,
    _ccfs_address,
    _fs_version,
    _deployments_dir,
    _user_level,
    _wallet_name,
    _wallet_path,
    _wallet_password,
    _wallet_seed,
    _target_networks,
    _api_key_path,
    _call_method,
    _retries_max,
    _tasks_parallel,
    _input_uris,
    _output_files) {
  let
    _cursor,
    _msg,
    _output_file,
    _output_file_exists_already,
    _uri,
    _uri_network_id,
    _uri_contract,
    _uri_namespace,
    _uri_hash;
  _cursor =
    0;
  _echo2(
    _output_files);
  for ( _uri of _input_uris ) {
    _msg =
      "Downloading URI " +
      `'${_uri}'.`;
    _msg_info(
      _msg);
    _output_file =
      _output_files[
        _cursor];
    try {
      _uri_network_id =
        _network_id_get(
          _uri);
    }
    catch(
      _error) {
      _msg =
        "Error extracting URI network ID.";
      _msg_error(
        _msg,
        0);
      // throw _error;
    }
    try {
      _uri_contract =
        _contract_get(
          _uri);
    }
    catch(
      _error) {
      _msg =
        "Error extracting URI contract address.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    const
      _contract_setup_args = [
        _uri_contract,
        [ _uri_network_id ],    // target networks
        _fs_version,
        _user_level,
        "json",                 // configuration format
        _deployments_dir
      ];
    try {
      _uri_contract =
        await _contract_setup.apply(
          null,
          _contract_setup_args);
    }
    catch(
      _error) {
      _msg =
        "Error running '_contract_setup' with " +
        `arguments:`;
      _msg_error(
        _msg,
        0);
      _echo2(
        _error);
      throw _error;
    }
    try {
      _uri_namespace =
        _namespace_get(
          _uri);
    }
    catch(
      _error) {
      _msg =
        "Error extracting URI namespace.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    try {
      _uri_namespace =
        await _namespace_setup(
          _uri_namespace);
    }
    catch(
      _error) {
      _msg =
        "Error during namespace setup.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    try {
      _uri_hash =
        _hash_get(
          _uri);
    }
    catch(
      _error) {
      _msg =
        "Error extracting URI hash.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    try {
      _hash_check(
        _uri_hash);
    }
    catch(
      _error) {
      _msg =
        "Error checking URI hash.";
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    _output_file_exists_already =
      _file_exists(
        _output_file);
    if ( _output_file_exists_already ) {
      _output_file_hash =
        _file_hash(
          _output_file);
    }
    _cursor =
      _cursor + 1;
    true;
  }
  return [
    "ciao"
  ];
}

