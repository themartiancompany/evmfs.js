function
  _encoding_skip_check(
    _encoding_skip) {
  let
    _encoding_skip_get,
    _msg;
  _encoding_skip_get =
    false;
  const
    _default =
      "n";
  const
    _encoding_skip_type =
      typeof(
        _encoding_skip);
  if ( _encoding_skip_type === "undefined" ) {
    _msg =
      "Variable 'encoding skip' is undefined, " +
      `setting default '${_default}'.`;
    _msg_info(
      _msg);
    _encoding_skip_get =
      true;
  }
  else if ( _encoding_skip_type === "string" ) {
    if ( _encoding_skip.length < 1 ) {
      _msg =
        "Variable 'encoding skip' is an empty string, " +
        `setting default '${_default}'.`;
      _msg_info(
        _msg);
      _encoding_skip_get =
        true;
    }
  }
  else if ( _encoding_skip_type === "boolean" ) {
    if ( _encoding_skip ) {
      _encoding_skip =
        "y";
    }
    else {
      _encoding_skip =
        "n";
    }
  }
  else if ( _encoding_skip_type === "object" ) {
    if ( _encoding_skip === null ) {
      _msg =
        "Encoding skip variable should be 'y' or 'n'.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    else {
      const
        _encoding_skip_keys =
          Object.keys(
            _encoding_skip);
      if ( _encoding_skip_keys.length < 1 ) {
        _msg =
          "Variable 'encoding skip' is an empty object, " +
          `setting default '${_default}'.`;
        _msg_info(
          _msg);
        _encoding_skip_get =
          true;
      }
      else {
        _msg =
          "Encoding skip variable should " +
          "be 'y' or 'n', not an object:";
        _msg_error(
          _msg,
          0);
        _echo2(
          _encoding_skip);
        throw _msg;
      }
    }
  }
  else {
    _msg =
      "Variable 'encoding skip' should be " +
      "'y' or 'n', not:";
    _msg_error(
      _msg,
      0);
    _echo2(
      _encoding_skip);
    throw _msg;
  }
  if ( _encoding_skip_get ) {
     _encoding_skip =
       _default;
  }
  if ( _encoding_skip != "n" &&
       _encoding_skip != "y" ) {
    _msg =
      "The 'encoding skip' variable should " +
      "be 'y' or 'n'.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  return _encoding_skip;
}

