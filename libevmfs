        _msg =
          "Variable 'lock only' is an empty object, " +
          `setting default '${_default}'.`;
        _msg_info(
          _msg);
        _lock_only_get =
          true;
      }
      else {
        _msg =
          "The 'lock only' variable should be " +
          "'y' or 'n', not an object.";
        _msg_error(
          _msg,
          0);
        _echo2(
          _lock_only);
        throw _msg;
      }
    }
  }
  else {
    _msg =
