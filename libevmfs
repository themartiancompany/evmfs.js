function
  _input_uris_auto_detect() {
  let
    _input_uris,
    _msg,
    _uri;
  _input_uris =
    _get(
      "input",
      "uris");
  const
    _target_command =
      _get(
        "target",
        "command");
  const
    _target_key =
      _get(
        "target",
        "key");
  const
    _target_value =
      _get(
        "target",
        "value");
  const
    _command_args =
      _get(
        "command",
        "args");
  if ( _target_command === "get" ) {
    if ( _target_key === "" ) {
      _msg =
        "No input URI.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    _input_uris.push(
      _target_key);
    if ( _target_value != "" ) {
      _input_uris.push(
        _target_value);
    }
    if ( 0 < _command_args.length ) {
      _input_uris =
        _input_uris.concat(
          _command_args);
    }
    _set(
      "input",
      "uris",
      _input_uris);
  }
}

function
  _input_files_auto_detect() {
