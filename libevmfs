function
  _call_timeout_auto_detect() {
  let
    _call_timeout,
    _msg;
  const
    _target_command =
      _get(
        "target",
        "command");
  if ( _target_command === "get" ) {
    _call_timeout =
      3000;
  }
  else if ( _target_command === "publish" ) {
    _call_timeout =
      60000;
  }
  else {
    _msg =
      `Unknown command '${_target_command}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  _override_set(
    "call",
    "timeout",
    _call_timeout);
}

