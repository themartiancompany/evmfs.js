function
  _hash_type_check(
    _hash_type) {
  let
    _hash_type_get,
    _msg;
  _hash_type_get =
    false;
  const
    _default =
      "sha256sum";
  const
    _hash_type_type =
      typeof(
        _hash_type);
  if ( _hash_type_type === "undefined" ) {
    _msg =
      "Hash type undefined, setting " +
      `default type '${_default}'.`;
    _msg_info(
      _msg);
    _hash_type_get =
      true;
  }
  else if ( _hash_type_type === "string" ) {
    if ( _hash_type.length < 1 ) {
      _msg =
        "Hash type is an empty, setting " +
        `default type '${_default}'.`;
      _msg_info(
        _msg);
      _hash_type_get =
        true;
    }
    else {
      if ( _hash_type === "sha256sum" ) {
        true;
      }
      else if ( _hash_type === "sha512sum" ) {
        true;
      }
      else {
        _msg =
          `Unknown hash type '${_hash_type}'.`;
        _msg_error(
          _msg,
          0);
        throw _msg;
      }
    }
  }
  else {
    _msg =
      `Unknown type '${_hash_type_type}' ` +
      `for variable 'hash type'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _hash_type_get ) {
    _hash_type =
      _default;
  }
  return _hash_type;
}

async function
  _hash_check(
    _hash,
    _hash_type) {
  let
    _msg,
    _re;
  try {
    _hash_type =
      _hash_type_check(
        _hash_type);
  }
  catch(
    _error) {
    _msg =
      "Error checking hash type.";
    _msg_error(
      _msg,
      0);
    throw _error;
  }
  if ( _hash.length < 1 ) {
    _msg =
      "Empty URI hash.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _hash_type === "sha256sum" ) {
    _re =
      new RegExp(
        "[a-fA-F0-9]{64}$");
  }
  else if ( _hash_type === "sha512sum" ) {
    _re =
      new RegExp(
        "[a-fA-F0-9]{128}$");
  }
  else {
    _msg =
      "Check for hash type " +
      `'${_hash_type}' not implemented.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  const
    _valid =
      _hash.match(
        _re);
  if ( ! _valid ) {
    _msg =
      `Hash '${_hash}' ` +
      `of type '${_hash_type}' ` +
      "not valid.";
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
}

async function
  _contract_type_get(
    _contract_address,
    _fs_version,
    _target_networks,
    _user_level,
    _configuration_format,
    _deployments_dir) {
  let
    _address,
    _contract_addresses,
    _evm_contract_deployment_address_args,
    _msg,
    _network,
    _type;
  const
    _results =
      [];
  const
    _contracts_types = [
      "FileSystem",
      "CrossChainFileSystem"
    ];
  _network =
    _target_networks[
      0];
  const
    _network_type =
      typeof(
        _network);
  _msg =
    "Looking for contract types " +
    `having address '${_contract_address}'.`;
  _msg_info(
    _msg);
  if ( _network_type === "undefined" ) {
    for ( _type of _contracts_types ) {
      _evm_contract_deployment_address_args = [
        [],                  // target networks
        [],                  // networks ids
        "n",                 // all networks
        "evmfs",
        _type,
        _fs_version,
        _user_level,
        _configuration_format,
        _deployments_dir,
        "object"
      ];
      try {
        _contract_addresses =
          await _evm_contract_deployment_address.apply(
            null,
            _evm_contract_deployment_address_args);
      }
      catch(
        _error) {
        _msg =
          "Error locally retrieving " +
          "contract address.";
        _msg_error(
          _msg);
        _echo2(
          _error);
        throw _error;
      }
      for ( _network in _contract_addresses ) {
        _address =
          _contract_addresses[
            _network];
        if ( _address === _contract_address ) {
          _results.push([
            _type,
            _network, 
            _address
          ]);
        }
      }
    }
  }
  else {
    for ( _type of _contracts_types ) {
      _evm_contract_deployment_address_args = [
        _target_networks,    // target networks
        _target_networks,    // networks ids
        "n",                 // all networks
        "evmfs",
        _type,
        _fs_version,
        _user_level,
        _configuration_format,
        _deployments_dir,
        "object"
      ];
      try {
        _contract_addresses =
          await _evm_contract_deployment_address.apply(
            null,
            _evm_contract_deployment_address_args);
      }
      catch(
        _error) {
        _msg =
          "Error locally retrieving " +
          "contract address.";
        _msg_error(
          _msg);
        _echo2(
          _error);
        throw _error;
      }
      for ( _network in _contract_addresses ) {
        _address =
          _contract_addresses[
            _network];
        if ( _address === _contract_address ) {
          _results.push([
            _type,
            _network, 
            _address
          ]);
        }
      }
    }
  }
  if ( 1 < _results.length ) {
    _msg =
      "More than a file system type corresponding " +
      "found for the given contract:";
    _msg_info(
      _msg);
    const
      _global =
        _global_get();
    const
      _quiet =
        _global[
          "quiet"];
    if ( _quiet === "n" ) {
      _echo(
        _results);
    }
  }
  return _results;
}

async function
  _contract_setup(
    _contract_address,
    _target_networks,
    _fs_version,
    _user_level,
    _configuration_format,
    _deployments_dir) {
  let
    _address,
    _contract_address_get,
    _contract_type,
    _contracts_candidates,
    _msg,
    _network;
  _contract_address_get =
    false;
  const
    _contract_address_type =
      typeof(
        _contract_address);
  if ( _contract_address_type === "string" ) {
    if ( _contract_address.length < 1 ) {
      _msg =
        "No EVMFS contract address specified, " +
        "inferring it automatically.";
      _msg_info(
        _msg);
      _contract_address_get =
        true;
    }
  }
  else {
    _msg =
      `Unknown type '${_contract_address_type}' for ` +
      "variable contract address.";
    _msg_warning(
      _msg);
  }
  if ( _contract_address_get ) {
    const
      _target_app =
        "evmfs";
    const
      _evm_contract_deployment_address_args = [
        _target_networks,
        _target_networks,
        "n",                 // all networks
        _target_app,
        "FileSystem",
        _fs_version,
        _user_level,
        _configuration_format,
        _deployments_dir
      ];
    try {
      _quiet =
        _global[
          "quiet"];
      _msg =
        "Running '_evm_contract_deployment_address' " +
        "with arguments:";
      if ( _quiet === "n" ) {
        _echo(
          _evm_contract_deployment_address_args);
      }
      _contract_address =
        await _evm_contract_deployment_address.apply(
          null,
          _evm_contract_deployment_address_args);
    }
    catch(
      _error) {
      _msg =
        "Error locally retrieving " +
        "contract address.";
      _msg_error(
        _msg);
      _echo2(
        _error);
      throw _error;
    }
  }
  else {
    const
      _contract_type_get_args = [
        _contract_address,
        _fs_version,
        _target_networks,
        _user_level,
        _configuration_format,
        _deployments_dir
      ];
    try {
      _contracts_candidates =
        await _contract_type_get.apply(
          null,
          _contract_type_get_args);
    }
    catch(
      _error) {
      _msg =
        "Error running '_contract_type_get' " +
        "with arguments:"
      _msg_error(
        _msg,
        0);
      _echo2(
        _contract_type_get_args);
      _echo2(
        _error);
      throw _error;
    }
  }
  if ( 1 === _contracts_candidates.length ) {
    [ _contract_type ] =
      _contracts_candidates[
        0]
  }
  else if ( 1 < _contracts_candidates.length ) {
    _msg =
      "Found more than a contract type, " +
      "assuming the cross-chain one is the " +
      "correct one because exist check can be " +
      "postponed to a future release.";
    _msg_info(
      _msg);
    _echo(
      _contracts_candidates);
    _msg_warning(
      _msg);
    for ( [ _contract_type,
            _network,
            _address ] of _contracts_candidates ) {
      if ( _address === _contract_address ) {
        break;
      }
    }
  }
  return [
    _contract_address,
    _contract_type
  ];
}

