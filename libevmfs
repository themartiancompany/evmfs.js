          null,
          _chunk_get_args);
    }
    catch(
      _error) {
      _msg =
        `Error retrieving chunk ` +
        `with index '${_index}'`;
      _msg_error(
        _msg,
        0);
      throw _error;
    }
    _chunks.push(
      _piece);
  }
  return _chunks;
