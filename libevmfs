        "n";
    }
  }
  else if ( _lock_only_type === "object" ) {
    if ( _lock_only === null ) {
      _msg =
        "The 'lock only' variable should be " +
        "'y' or 'n', not 'null'.";
      _msg_error(
        _msg,
        0);
      throw _msg;
    }
    else {
      const
        _lock_only_keys =
          Object.keys(
            _lock_only);
