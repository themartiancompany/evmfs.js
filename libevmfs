function
  _address_section_get(
    _uri,
    _position) {
  let
    _msg,
    _uri_array_reverse;
  const
    _uri_type =
      typeof(
        _uri);
  if ( _uri_type != "string" ) {
    const
      _msg =
        `Unknown type '${_uri_type}' ` +
        `for uri '${_uri}'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  try {
    _uri_array_reverse =
      _uri.split("/").reverse();
  }
  catch(
    _error) {
    _msg =
      "Error splitting URI " +
      `'${_uri}'.`;
    _msg_error(
      _msg,
      0);
    _echo2(
      _error);
    throw _error;
  }
  return _uri_array_reverse[
           _position];
}

